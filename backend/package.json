{
  "name": "backend",
  "version": "1.0.0",
  "main": "server.js",
  "engines": {
    "node": ">=18.0.0",
    "npm": ">=9.0.0"
  },
  "scripts": {
    "test": "jest --verbose",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage",
    "start": "node server.js",
    "dev": "nodemon server.js",
    "postinstall": "echo 'Backend dependencies installed successfully'",
    "db:setup-wizard": "node scripts/setup-wizard.js",
    "db:init": "node scripts/dbInit.js",
    "db:clean": "node scripts/dbClean.js",
    "db:migrate": "node scripts/migrate.js",
    "db:migrate:users": "node scripts/migrateUsers.js",
    "db:migrate:rbac": "node scripts/migrateRBAC.js && node scripts/migrateRBACColumns.js",
    "db:migrate:rbac-system": "node scripts/migrateRBACSystem.js",
    "db:setup-rbac": "node quickSetupRBAC.js",
    "db:migrate:levels": "node scripts/migrateLevels.js",
    "db:migrate:attendance": "node scripts/migrateAttendanceEnhancements.js",
    "db:migrate:all": "npm run db:migrate:users && npm run db:migrate:rbac && npm run db:migrate:rbac-system && npm run db:migrate:levels && npm run db:migrate:attendance",
    "db:verify": "node scripts/dbVerify.js",
    "db:reset": "npm run db:clean && npm run db:init",
    "db:trim": "node scripts/trimEmployees.js",
    "db:seed-attendance": "node scripts/seedAttendance.js",
    "db:setup": "node scripts/dbInit.js",
    "holidays:init": "node scripts/initHolidays.js"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "description": "",
  "dependencies": {
    "bcryptjs": "^2.4.3",
    "cors": "^2.8.6",
    "date-holidays": "^2.0.0",
    "dotenv": "^17.3.1",
    "express": "^5.2.1",
    "express-rate-limit": "^7.5.0",
    "helmet": "^8.1.0",
    "jsonwebtoken": "^9.0.0",
    "kenat": "^3.2.0",
    "minio": "^8.0.6",
    "multer": "^2.1.1",
    "mysql2": "^3.19.0",
    "node-cron": "^4.2.1",
    "pdf-lib": "^1.17.1",
    "puppeteer": "^25.1.0",
    "uuid": "^13.0.0"
  },
  "devDependencies": {
    "fast-check": "^4.10.2",
    "jest": "^29.7.0",
    "nodemon": "^3.1.14",
    "supertest": "^7.3.1"
  },
  "jest": {
    "testEnvironment": "node",
    "coveragePathIgnorePatterns": [
      "/node_modules/"
    ],
    "testMatch": [
      "**/__tests__/**/*.test.js"
    ]
  }
}
