# Production Environment Variables Template
# DO NOT commit this file with real values
# Set these in Render Dashboard -> Environment

# Server Configuration
NODE_ENV=production
PORT=5000

# Database Configuration (Render will auto-populate from database service)
DB_HOST=${DB_HOST}
DB_USER=${DB_USER}
DB_PASSWORD=${DB_PASSWORD}
DB_NAME=${DB_NAME}
DB_CONNECTION_LIMIT=10

# MinIO Object Storage Configuration
# You'll need to set up MinIO separately (see deployment guide)
MINIO_ENDPOINT=${MINIO_ENDPOINT}
MINIO_PORT=443
MINIO_USE_SSL=true
MINIO_ACCESS_KEY=${MINIO_ACCESS_KEY}
MINIO_SECRET_KEY=${MINIO_SECRET_KEY}
MINIO_BUCKET=mesob-hrms
MINIO_BUCKET_AUTO_CREATE=true

# JWT Authentication Configuration
# Render will auto-generate these
JWT_SECRET=${JWT_SECRET}
JWT_REFRESH_SECRET=${JWT_REFRESH_SECRET}
JWT_EXPIRES_IN=1d
JWT_REFRESH_EXPIRES_IN=7d

# Frontend URL (for CORS)
FRONTEND_URL=${FRONTEND_URL}
