# Server Configuration
PORT=5000

# Database Configuration
DB_HOST=localhost
DB_USER=mesob
DB_PASSWORD=mesob_password
DB_NAME=mesob_hrms
# Optional: DB_CONNECTION_LIMIT=10

# MinIO Object Storage Configuration
MINIO_ENDPOINT=localhost
MINIO_PORT=9000
MINIO_ACCESS_KEY=admin
MINIO_SECRET_KEY=password123
MINIO_BUCKET=mesob-hrms
MINIO_BUCKET_AUTO_CREATE=true

# JWT Authentication Configuration
JWT_SECRET=your_secret_key_change_this_in_production
JWT_REFRESH_SECRET=your_refresh_key_change_this_in_production
JWT_EXPIRES_IN=1d
JWT_REFRESH_EXPIRES_IN=7d

# Permit.io Authorization Configuration
# Get your API key from: https://app.permit.io/settings/api-keys
PERMIT_API_KEY=permit_key_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# Environment name (default: production)
PERMIT_ENV=production
# PDP (Policy Decision Point) URL
# For cloud PDP (default): https://cloudpdp.api.permit.io
# For local PDP: http://localhost:7766
PERMIT_PDP_URL=https://cloudpdp.api.permit.io
# Enable debug logs (set to 'true' for troubleshooting)
PERMIT_DEBUG=false
