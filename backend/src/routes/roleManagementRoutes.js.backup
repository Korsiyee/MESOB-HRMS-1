/**
 * Role Management Routes
 * 
 * API endpoints for RBAC system administration
 */

const express = require('express');
const router = express.Router();
const roleManagementController = require('../controllers/roleManagementController');
const { authorize } = require('../middleware/authorize');
const { canModifyRole, canAssignRole, canModifyUser, preventSystemRoleModification } = require('../middleware/roleHierarchy');

// ============================================================================
// ROLES
// ============================================================================

// Get all roles
router.get(
  '/roles',
  authorize({ permissions: 'Roles.View' }),
  roleManagementController.getAllRoles
);

// Get role details
router.get(
  '/roles/:roleUuid',
  authorize({ permissions: 'Roles.View' }),
  roleManagementController.getRoleDetails
);

// Create role
router.post(
  '/roles',
  authorize({ permissions: 'Roles.Create' }),
  roleManagementController.createRole
);

// Update role
router.put(
  '/roles/:roleUuid',
  authorize({ permissions: 'Roles.Update' }),
  canModifyRole('roleUuid'),
  preventSystemRoleModification('roleUuid'),
  roleManagementController.updateRole
);

// Delete role
router.delete(
  '/roles/:roleUuid',
  authorize({ permissions: 'Roles.Delete' }),
  canModifyRole('roleUuid'),
  preventSystemRoleModification('roleUuid'),
  roleManagementController.deleteRole
);

// Set role status (activate/deactivate)
router.patch(
  '/roles/:roleUuid/status',
  authorize({ permissions: 'Roles.Update' }),
  canModifyRole('roleUuid'),
  roleManagementController.setRoleStatus
);

// Get users assigned to role
router.get(
  '/roles/:roleUuid/users',

// Get permissions for a specific role
router.get(
  '/roles/:roleUuid/permissions',
  authorize({ permissions: 'Roles.View' }),
  roleManagementController.getRolePermissions
);

// Get permissions for a specific role
router.get(
  '/roles/:roleUuid/permissions',
  authorize({ permissions: 'Roles.View' }),
  roleManagementController.getRolePermissions
);
  authorize({ permissions: ['Roles.View', 'Accounts.View'], logic: 'AND' }),
  roleManagementController.getRoleUsers
);

// ============================================================================
// PERMISSIONS & RESOURCES
// ============================================================================

// Get all permissions grouped by resource
router.get(
  '/permissions',
  authorize({ permissions: 'Roles.View' }),
  roleManagementController.getAllPermissions
);

// Get all data scopes
router.get(
  '/scopes',
  authorize({ permissions: 'Roles.View' }),
  roleManagementController.getAllScopes
);

// ============================================================================
// PERMISSION ASSIGNMENT
// ============================================================================

// Assign single permission to role
router.post(
  '/roles/:roleUuid/permissions',
  authorize({ permissions: 'Roles.AssignPermissions' }),
  canModifyRole('roleUuid'),
  roleManagementController.assignPermission
);

// Remove permission from role
router.delete(
  '/roles/:roleUuid/permissions/:permissionUuid',
  authorize({ permissions: 'Roles.AssignPermissions' }),
  canModifyRole('roleUuid'),
  roleManagementController.removePermission
);

// Bulk assign permissions
router.post(
  '/roles/:roleUuid/permissions/bulk',
  authorize({ permissions: 'Roles.AssignPermissions' }),
  canModifyRole('roleUuid'),
  roleManagementController.bulkAssignPermissions
);

// Replace all role permissions
router.put(
  '/roles/:roleUuid/permissions',
  authorize({ permissions: 'Roles.AssignPermissions' }),
  canModifyRole('roleUuid'),
  roleManagementController.replacePermissions
);

// ============================================================================
// SCOPE ASSIGNMENT
// ============================================================================

// Assign scope to role-permission
router.post(
  '/roles/:roleUuid/permissions/:permissionUuid/scope',
  authorize({ permissions: 'Roles.ManageScopes' }),
  canModifyRole('roleUuid'),
  roleManagementController.assignScope
);

// Remove scope from role-permission
router.delete(
  '/roles/:roleUuid/permissions/:permissionUuid/scope',
  authorize({ permissions: 'Roles.ManageScopes' }),
  canModifyRole('roleUuid'),
  roleManagementController.removeScope
);

// ============================================================================
// USER ROLE ASSIGNMENT
// ============================================================================

// Assign role to user
router.put(
  '/users/:userUuid/role',
  authorize({ permissions: 'Accounts.AssignRole' }),
  canModifyUser('userUuid'),
  canAssignRole('roleUuid'),
  roleManagementController.assignRoleToUser
);

// ============================================================================
// USER PERMISSION OVERRIDES
// ============================================================================

// Get user's permission overrides
router.get(
  '/users/:userUuid/overrides/permissions',
  authorize({ permissions: 'Accounts.View' }),
  roleManagementController.getUserPermissionOverrides
);

// Add permission override
router.post(
  '/users/:userUuid/overrides/permissions',
  authorize({ permissions: 'Accounts.Update' }),
  canModifyUser('userUuid'),
  roleManagementController.addPermissionOverride
);

// Remove permission override
router.delete(
  '/overrides/permissions/:overrideUuid',
  authorize({ permissions: 'Accounts.Update' }),
  roleManagementController.removePermissionOverride
);

// ============================================================================
// USER SCOPE OVERRIDES
// ============================================================================

// Get user's scope overrides
router.get(
  '/users/:userUuid/overrides/scopes',
  authorize({ permissions: 'Accounts.View' }),
  roleManagementController.getUserScopeOverrides
);

// Add scope override
router.post(
  '/users/:userUuid/overrides/scopes',
  authorize({ permissions: 'Accounts.Update' }),
  canModifyUser('userUuid'),
  roleManagementController.addScopeOverride
);

// Remove scope override
router.delete(
  '/overrides/scopes/:overrideUuid',
  authorize({ permissions: 'Accounts.Update' }),
  roleManagementController.removeScopeOverride
);

// ============================================================================
// PERMISSION DELEGATIONS
// ============================================================================

// Get user's delegations
router.get(
  '/users/:userUuid/delegations',
  authorize({ permissions: 'Accounts.View' }),
  roleManagementController.getUserDelegations
);

// Create delegation
router.post(
  '/delegations',
  authorize({ permissions: 'Accounts.Update' }),
  roleManagementController.createDelegation
);

// Revoke delegation
router.delete(
  '/delegations/:delegationUuid',
  authorize({ permissions: 'Accounts.Update' }),
  roleManagementController.revokeDelegation
);

// ============================================================================
// USER PERMISSION INFO
// ============================================================================

// Get user's effective permissions (detailed)
router.get(
  '/users/:userUuid/effective-permissions',
  authorize({ permissions: 'Accounts.View' }),
  roleManagementController.getUserEffectivePermissions
);

// Get current user's permissions
router.get(
  '/my-permissions',
  authorize({ permissions: [] }), // Just authentication required
  roleManagementController.getMyPermissions
);

// ============================================================================
// AUDIT LOGS
// ============================================================================

// Get authorization audit logs
router.get(
  '/audit-logs',
  authorize({ permissions: 'Logs.View' }),
  roleManagementController.getAuditLogs
);

module.exports = router;
