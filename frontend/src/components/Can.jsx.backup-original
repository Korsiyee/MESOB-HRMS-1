/**
 * Can Component
 * 
 * Conditionally render children based on user permissions.
 * This component hides UI elements the user cannot access.
 * 
 * Usage:
 *   <Can action="create" resource="employees">
 *     <button>Create Employee</button>
 *   </Can>
 * 
 *   <Can action="view" resource="reports" fallback={<p>Access Denied</p>}>
 *     <ReportsPage />
 *   </Can>
 * 
 *   <Can action="update" resource="employees" loading={<Spinner />}>
 *     <EditForm />
 *   </Can>
 * 
 * IMPORTANT: This is a UI convenience only.
 * The backend ALWAYS enforces authorization.
 * Never rely on frontend permission checks for security.
 */

import { usePermission } from '../hooks/usePermission';

/**
 * Conditional rendering component based on permissions
 * 
 * @param {Object} props
 * @param {string} props.action - Action to check (e.g., 'view', 'create', 'update', 'delete')
 * @param {string} props.resource - Resource to check (e.g., 'employees', 'attendance')
 * @param {React.ReactNode} props.children - Content to render if allowed
 * @param {React.ReactNode} [props.fallback=null] - Content to render if not allowed
 * @param {React.ReactNode} [props.loading=null] - Content to render while loading
 * @param {boolean} [props.showLoading=false] - Whether to show loading state
 */
export function Can({ 
  action, 
  resource, 
  children, 
  fallback = null, 
  loading: loadingContent = null,
  showLoading = false 
}) {
  const { allowed, loading } = usePermission(action, resource);

  // Show loading state if enabled
  if (loading && showLoading) {
    return loadingContent;
  }

  // Hide loading state by default (prevents flickering)
  if (loading) {
    return null;
  }

  // Show children if allowed, otherwise show fallback
  return allowed ? children : fallback;
}

/**
 * Can with ANY logic - show if user has any of the specified permissions
 * 
 * @example
 * <CanAny permissions={[
 *   { action: 'view', resource: 'employees' },
 *   { action: 'view', resource: 'attendance' }
 * ]}>
 *   <DashboardWidget />
 * </CanAny>
 */
export function CanAny({ permissions, children, fallback = null, loading: loadingContent = null, showLoading = false }) {
  const { useAnyPermission } = require('../hooks/usePermission');
  const { allowed, loading } = useAnyPermission(permissions);

  if (loading && showLoading) {
    return loadingContent;
  }

  if (loading) {
    return null;
  }

  return allowed ? children : fallback;
}

/**
 * Can with ALL logic - show if user has all of the specified permissions
 * 
 * @example
 * <CanAll permissions={[
 *   { action: 'create', resource: 'employees' },
 *   { action: 'create', resource: 'accounts' }
 * ]}>
 *   <CreateEmployeeWithAccountButton />
 * </CanAll>
 */
export function CanAll({ permissions, children, fallback = null, loading: loadingContent = null, showLoading = false }) {
  const { useAllPermissions } = require('../hooks/usePermission');
  const { allowed, loading } = useAllPermissions(permissions);

  if (loading && showLoading) {
    return loadingContent;
  }

  if (loading) {
    return null;
  }

  return allowed ? children : fallback;
}

/**
 * Inverted Can - show if user does NOT have permission
 * Useful for showing "upgrade" messages or alternative UI
 * 
 * @example
 * <Cannot action="export" resource="reports">
 *   <p>Upgrade to export reports</p>
 * </Cannot>
 */
export function Cannot({ action, resource, children, fallback = null }) {
  const { allowed, loading } = usePermission(action, resource);

  if (loading) {
    return null;
  }

  // Inverted logic - show if NOT allowed
  return !allowed ? children : fallback;
}

export default Can;
