  KEY `idx_delegations_active` (`end_date`, `revoked_at`),
  KEY `idx_delegations_revoked_by` (`revoked_by_uuid`),
  CONSTRAINT `fk_delegations_delegatee` FOREIGN KEY (`delegatee_user_uuid`) REFERENCES `Users` (`uuid`) ON DELETE CASCADE,
  CONSTRAINT `fk_delegations_delegator` FOREIGN KEY (`delegator_user_uuid`) REFERENCES `Users` (`uuid`) ON DELETE CASCADE,
  CONSTRAINT `fk_delegations_occupation` FOREIGN KEY (`occupation_uuid`) REFERENCES `Occupations` (`uuid`) ON DELETE CASCADE,
  CONSTRAINT `fk_delegations_revoked_by` FOREIGN KEY (`revoked_by_uuid`) REFERENCES `Users` (`uuid`) ON DELETE SET NULL,
  CONSTRAINT `chk_delegations_dates` CHECK (`end_date` > `start_date`)
) ENGINE=InnoDB DEFAULT CHARSET=utf8mb4 COLLATE=utf8mb4_unicode_ci
COMMENT='Temporary delegation of occupation-based permissions';

-- ============================================================================
-- SECTION 5: COMPENSATION (LEVELS AND ALLOWANCES)
-- ============================================================================

--
-- Table: Levels
-- Purpose: Employee compensation levels
-- 1NF: ✓ Atomic values
-- 2NF: ✓ Single-column PK
-- 3NF: ✓ No transitive dependencies
--
DROP TABLE IF EXISTS `Levels`;
CREATE TABLE `Levels` (
  `uuid` VARCHAR(36) NOT NULL,
  `level_code` VARCHAR(50) NOT NULL COMMENT 'Human-readable level code',
  `name` VARCHAR(200) NOT NULL,
  `description` TEXT DEFAULT NULL,
  `sort_order` INT NOT NULL DEFAULT 0,
  `is_active` TINYINT(1) NOT NULL DEFAULT 1,
  `created_at` DATETIME NOT NULL DEFAULT CURRENT_TIMESTAMP(),
  `updated_at` DATETIME NOT NULL DEFAULT CURRENT_TIMESTAMP() ON UPDATE CURRENT_TIMESTAMP(),
  PRIMARY KEY (`uuid`),
  UNIQUE KEY `uk_positions_code` (`position_code`),
  UNIQUE KEY `uk_levels_name` (`name`),
  KEY `idx_levels_active` (`is_active`),
  KEY `idx_levels_sort_order` (`sort_order`)
) ENGINE=InnoDB DEFAULT CHARSET=utf8mb4 COLLATE=utf8mb4_unicode_ci
COMMENT='Employee compensation level definitions';

--
-- Table: LevelVersions
-- Purpose: Historical versions of level compensation
-- 1NF: ✓ Atomic values
-- 2NF: ✓ All attributes depend on PK
-- 3NF: ✓ No transitive dependencies
--
DROP TABLE IF EXISTS `LevelVersions`;
CREATE TABLE `LevelVersions` (
  `uuid` VARCHAR(36) NOT NULL,
  `level_uuid` VARCHAR(36) NOT NULL,
  `base_salary` DECIMAL(15,2) NOT NULL DEFAULT 0.00,
  `allowances_json` JSON DEFAULT NULL COMMENT 'Allowances: [{type,name,amount,is_taxable}] - OPTIMIZED',
  `effective_from` DATE NOT NULL,
  `effective_to` DATE DEFAULT NULL COMMENT 'NULL means currently active',
  `version_number` INT NOT NULL DEFAULT 1,
  `notes` TEXT DEFAULT NULL,
  `created_by_uuid` VARCHAR(36) DEFAULT NULL,
  `created_at` DATETIME NOT NULL DEFAULT CURRENT_TIMESTAMP(),
  `updated_at` DATETIME NOT NULL DEFAULT CURRENT_TIMESTAMP() ON UPDATE CURRENT_TIMESTAMP(),
  PRIMARY KEY (`uuid`),
  UNIQUE KEY `uk_positions_code` (`position_code`),
  UNIQUE KEY `uk_level_effective_from` (`level_uuid`, `effective_from`),
  KEY `idx_level_versions_level` (`level_uuid`),
  KEY `idx_level_versions_effective` (`level_uuid`, `effective_from`, `effective_to`),
  KEY `idx_level_versions_created_by` (`created_by_uuid`),
  CONSTRAINT `fk_level_versions_level` FOREIGN KEY (`level_uuid`) REFERENCES `Levels` (`uuid`) ON DELETE CASCADE,
  CONSTRAINT `fk_level_versions_created_by` FOREIGN KEY (`created_by_uuid`) REFERENCES `Users` (`uuid`) ON DELETE SET NULL,
  CONSTRAINT `chk_level_versions_dates` CHECK (`effective_to` IS NULL OR `effective_to` >= `effective_from`)
) ENGINE=InnoDB DEFAULT CHARSET=utf8mb4 COLLATE=utf8mb4_unicode_ci
COMMENT='Historical versions of level compensation';

--
-- Table: LevelAllowances
-- Purpose: Allowances associated with level versions
-- 1NF: ✓ Atomic values
-- 2NF: ✓ All attributes depend on PK
-- 3NF: ✓ No transitive dependencies
--
-- DEPRECATED: Will be removed
-- DROP TABLE IF EXISTS `LevelAllowances`;
-- DEPRECATED: To be consolidated into other tables
-- CREATE TABLE `LevelAllowances` (
  `uuid` VARCHAR(36) NOT NULL,
  `level_version_uuid` VARCHAR(36) NOT NULL,
  `allowance_type` ENUM('TRANSPORT','HOUSING','RESPONSIBILITY','HARDSHIP','SPECIAL','OTHER') NOT NULL,
  `allowance_name` VARCHAR(200) NOT NULL,
  `amount` DECIMAL(15,2) NOT NULL DEFAULT 0.00,
  `is_taxable` TINYINT(1) NOT NULL DEFAULT 1,
  `description` TEXT DEFAULT NULL,
  `created_at` DATETIME NOT NULL DEFAULT CURRENT_TIMESTAMP(),
  `updated_at` DATETIME NOT NULL DEFAULT CURRENT_TIMESTAMP() ON UPDATE CURRENT_TIMESTAMP(),
  PRIMARY KEY (`uuid`),
  UNIQUE KEY `uk_positions_code` (`position_code`),
  KEY `idx_allowances_version` (`level_version_uuid`),
  KEY `idx_allowances_type` (`allowance_type`),
  CONSTRAINT `fk_level_allowances_version` FOREIGN KEY (`level_version_uuid`) REFERENCES `LevelVersions` (`uuid`) ON DELETE CASCADE
) ENGINE=InnoDB DEFAULT CHARSET=utf8mb4 COLLATE=utf8mb4_unicode_ci
COMMENT='Allowances for each level version';

--
-- Table: EmployeeLevelHistory
-- Purpose: Historical level assignments for employees
-- 1NF: ✓ Atomic values
-- 2NF: ✓ All attributes depend on PK
-- 3NF: ✓ No transitive dependencies
-- NOTE: Source of truth for employee current level
--
DROP TABLE IF EXISTS `EmployeeLevelHistory`;
CREATE TABLE `EmployeeLevelHistory` (
  `uuid` VARCHAR(36) NOT NULL,
  `employee_uuid` VARCHAR(36) NOT NULL,
  `level_uuid` VARCHAR(36) NOT NULL,
  `level_version_uuid` VARCHAR(36) NOT NULL COMMENT 'Specific version at time of assignment',
  `effective_from` DATE NOT NULL,
  `effective_to` DATE DEFAULT NULL COMMENT 'NULL means currently active',
  `changed_by_uuid` VARCHAR(36) DEFAULT NULL,
  `reason` TEXT DEFAULT NULL,
  `created_at` DATETIME NOT NULL DEFAULT CURRENT_TIMESTAMP(),
  PRIMARY KEY (`uuid`),
  UNIQUE KEY `uk_positions_code` (`position_code`),
  KEY `idx_level_history_employee` (`employee_uuid`),
  KEY `idx_level_history_level` (`level_uuid`),
  KEY `idx_level_history_version` (`level_version_uuid`),
  KEY `idx_level_history_effective` (`employee_uuid`, `effective_from`, `effective_to`),
  KEY `idx_level_history_current` (`employee_uuid`, `effective_to`),
  KEY `idx_level_history_changed_by` (`changed_by_uuid`),
  CONSTRAINT `fk_level_history_employee` FOREIGN KEY (`employee_uuid`) REFERENCES `Employees` (`uuid`) ON DELETE CASCADE,
  CONSTRAINT `fk_level_history_level` FOREIGN KEY (`level_uuid`) REFERENCES `Levels` (`uuid`) ON DELETE RESTRICT,
  CONSTRAINT `fk_level_history_version` FOREIGN KEY (`level_version_uuid`) REFERENCES `LevelVersions` (`uuid`) ON DELETE RESTRICT,
  CONSTRAINT `fk_level_history_changed_by` FOREIGN KEY (`changed_by_uuid`) REFERENCES `Users` (`uuid`) ON DELETE SET NULL,
  CONSTRAINT `chk_level_history_dates` CHECK (`effective_to` IS NULL OR `effective_to` >= `effective_from`)
) ENGINE=InnoDB DEFAULT CHARSET=utf8mb4 COLLATE=utf8mb4_unicode_ci
COMMENT='Historical level assignments - SOURCE OF TRUTH for current employee level';

-- ============================================================================
-- SECTION 6: ATTENDANCE SYSTEM
-- ============================================================================

--
-- Table: Holidays
-- Purpose: Holiday calendar
-- 1NF: ✓ Atomic values
-- 2NF: ✓ Single-column PK
-- 3NF: ✓ No transitive dependencies
--
DROP TABLE IF EXISTS `Holidays`;
CREATE TABLE `Holidays` (
  `uuid` VARCHAR(50) NOT NULL,
  `holiday_date` DATE NOT NULL,
  `holiday_name` VARCHAR(255) NOT NULL,
  `calendar_year` VARCHAR(10) NOT NULL COMMENT 'e.g., 2024, 2016 EC',
  `calendar_type` VARCHAR(30) NOT NULL COMMENT 'GREGORIAN or ETHIOPIAN',
  `is_active` TINYINT(1) NOT NULL DEFAULT 1,
  `source` VARCHAR(30) NOT NULL DEFAULT 'MANUAL' COMMENT 'MANUAL, IMPORTED, SYSTEM',
  `description` TEXT DEFAULT NULL,
  PRIMARY KEY (`uuid`),
  UNIQUE KEY `uk_positions_code` (`position_code`),
  UNIQUE KEY `uk_holidays_date` (`holiday_date`),
  KEY `idx_holidays_year` (`calendar_year`),
  KEY `idx_holidays_active` (`is_active`)
) ENGINE=InnoDB DEFAULT CHARSET=utf8mb4 COLLATE=utf8mb4_unicode_ci
COMMENT='Holiday calendar for attendance calculations';

--
-- Table: AttendanceLogs
-- Purpose: Raw attendance check-in/check-out events
-- 1NF: ✓ Atomic values
-- 2NF: ✓ All attributes depend on PK
-- 3NF: ✓ No transitive dependencies
--
DROP TABLE IF EXISTS `AttendanceLogs`;
CREATE TABLE `AttendanceLogs` (
  `uuid` VARCHAR(36) NOT NULL,
  `employee_uuid` VARCHAR(36) NOT NULL,
  `date` DATE NOT NULL,
  `check_in` DATETIME DEFAULT NULL,
  `check_out` DATETIME DEFAULT NULL,
  `state` ENUM('PENDING','CHECKED_IN','CHECKED_OUT','CALCULATED') NOT NULL DEFAULT 'PENDING',
  `source` ENUM('MANUAL','DEVICE','SYSTEM','FACE_RECOGNITION') NOT NULL DEFAULT 'SYSTEM',
  `created_at` DATETIME NOT NULL DEFAULT CURRENT_TIMESTAMP(),
  `updated_at` DATETIME NOT NULL DEFAULT CURRENT_TIMESTAMP() ON UPDATE CURRENT_TIMESTAMP(),
  PRIMARY KEY (`uuid`),
  UNIQUE KEY `uk_positions_code` (`position_code`),
  KEY `idx_attendance_logs_employee` (`employee_uuid`),
  KEY `idx_attendance_logs_date` (`date`),
  KEY `idx_attendance_logs_state` (`state`),
  KEY `idx_attendance_logs_employee_date` (`employee_uuid`, `date`),
  CONSTRAINT `fk_attendance_logs_employee` FOREIGN KEY (`employee_uuid`) REFERENCES `Employees` (`uuid`) ON DELETE CASCADE
) ENGINE=InnoDB DEFAULT CHARSET=utf8mb4 COLLATE=utf8mb4_unicode_ci
COMMENT='Raw attendance check-in and check-out events';

--
-- Table: AttendanceSummary
-- Purpose: Daily attendance summary (calculated/corrected)
-- 1NF: ✓ Atomic values
-- 2NF: ✓ All attributes depend on PK
-- 3NF: ✓ No transitive dependencies except intentional denormalization
-- INTENTIONAL DENORMALIZATION: shift_name_snapshot, shift_start_time_snapshot, shift_end_time_snapshot
--   Reason: Historical preservation - shift definitions may change over time
--   Documentation: These snapshot fields preserve shift details at time of attendance
--
DROP TABLE IF EXISTS `AttendanceSummary`;
CREATE TABLE `AttendanceSummary` (
  `uuid` VARCHAR(36) NOT NULL,
  `employee_uuid` VARCHAR(36) NOT NULL,
  `date` DATE NOT NULL,
  `status` ENUM('PRESENT','ABSENT','LATE','ON_LEAVE') NOT NULL,
  `shift_uuid` VARCHAR(36) DEFAULT NULL COMMENT 'Reference to shift used',
  `shift_name_snapshot` VARCHAR(100) DEFAULT NULL COMMENT 'DENORMALIZED: Shift name at time of attendance',
  `shift_start_time_snapshot` TIME DEFAULT NULL COMMENT 'DENORMALIZED: Shift start time at time of attendance',
  `shift_end_time_snapshot` TIME DEFAULT NULL COMMENT 'DENORMALIZED: Shift end time at time of attendance',
  `leave_request_uuid` VARCHAR(36) DEFAULT NULL COMMENT 'Reference if status is ON_LEAVE',
  `worked_hours` DECIMAL(5,2) DEFAULT NULL,
  `overtime_hours` DECIMAL(5,2) DEFAULT NULL,
  `missing_hours` DECIMAL(5,2) DEFAULT NULL,
  `late_minutes` INT DEFAULT NULL,
  `break_duration_minutes` INT DEFAULT NULL,
  `corrected_by_uuid` VARCHAR(36) DEFAULT NULL COMMENT 'User who made manual corrections',
  `created_at` DATETIME NOT NULL DEFAULT CURRENT_TIMESTAMP(),
  `updated_at` DATETIME NOT NULL DEFAULT CURRENT_TIMESTAMP() ON UPDATE CURRENT_TIMESTAMP(),
  PRIMARY KEY (`uuid`),
  UNIQUE KEY `uk_positions_code` (`position_code`),
  UNIQUE KEY `uk_attendance_summary_employee_date` (`employee_uuid`, `date`),
  KEY `idx_attendance_summary_status` (`status`),
  KEY `idx_attendance_summary_date` (`date`),
  KEY `idx_attendance_summary_shift` (`shift_uuid`),
  KEY `idx_attendance_summary_leave` (`leave_request_uuid`),
  KEY `idx_attendance_summary_corrected_by` (`corrected_by_uuid`),
  CONSTRAINT `fk_attendance_summary_employee` FOREIGN KEY (`employee_uuid`) REFERENCES `Employees` (`uuid`) ON DELETE CASCADE,
  CONSTRAINT `fk_attendance_summary_shift` FOREIGN KEY (`shift_uuid`) REFERENCES `ShiftDefinitions` (`uuid`) ON DELETE SET NULL,
  CONSTRAINT `fk_attendance_summary_leave_request` FOREIGN KEY (`leave_request_uuid`) REFERENCES `leaveRequests` (`uuid`) ON DELETE SET NULL,
  CONSTRAINT `fk_attendance_summary_corrected_by` FOREIGN KEY (`corrected_by_uuid`) REFERENCES `Users` (`uuid`) ON DELETE SET NULL
) ENGINE=InnoDB DEFAULT CHARSET=utf8mb4 COLLATE=utf8mb4_unicode_ci
COMMENT='Daily attendance summary with intentional shift snapshots for historical preservation';

-- ============================================================================
-- SECTION 7: LEAVE MANAGEMENT
-- ============================================================================

--
-- Table: LeaveTypes
-- Purpose: Leave type definitions (Annual, Sick, Maternity, etc.)
-- 1NF: ✓ Atomic values
-- 2NF: ✓ Single-column PK
-- 3NF: ✓ No transitive dependencies
-- IMPROVEMENT: NEW TABLE - Extracted from leavePolicies VARCHAR field
--
DROP TABLE IF EXISTS `LeaveTypes`;
CREATE TABLE `LeaveTypes` (
  `uuid` VARCHAR(36) NOT NULL,
  `code` VARCHAR(50) NOT NULL,
  `name` VARCHAR(100) NOT NULL,
  `description` TEXT DEFAULT NULL,
  `requires_documentation` TINYINT(1) NOT NULL DEFAULT 0,
  `is_active` TINYINT(1) NOT NULL DEFAULT 1,
  `created_at` DATETIME NOT NULL DEFAULT CURRENT_TIMESTAMP(),
  PRIMARY KEY (`uuid`),
  UNIQUE KEY `uk_positions_code` (`position_code`),
  UNIQUE KEY `uk_leave_types_code` (`code`),
  KEY `idx_leave_types_active` (`is_active`)
) ENGINE=InnoDB DEFAULT CHARSET=utf8mb4 COLLATE=utf8mb4_unicode_ci
COMMENT='Leave type definitions (Annual, Sick, Maternity, etc.)';

--
-- Table: LeavePolicies
-- Purpose: Leave policies with entitlement rules
-- 1NF: ✓ Atomic values
-- 2NF: ✓ All attributes depend on PK
-- 3NF: ✓ No transitive dependencies
-- IMPROVEMENT: Changed leaveType VARCHAR to leave_type_uuid FK
--
DROP TABLE IF EXISTS `LeavePolicies`;
CREATE TABLE `LeavePolicies` (
  `uuid` VARCHAR(36) NOT NULL,
  `leave_type_uuid` VARCHAR(36) NOT NULL,
  `base_days` INT NOT NULL COMMENT 'Base entitlement days',
  `increment_per_year` INT NOT NULL DEFAULT 0 COMMENT 'Additional days per year of service',
  `max_days` INT NOT NULL COMMENT 'Maximum entitlement cap',
  `eligibility_months` INT NOT NULL COMMENT 'Months of service required for eligibility',
  `use_budget_year` TINYINT(1) NOT NULL COMMENT 'True if tied to budget year, false if anniversary-based',
  `created_at` DATETIME NOT NULL DEFAULT CURRENT_TIMESTAMP(),
  `updated_at` DATETIME NOT NULL DEFAULT CURRENT_TIMESTAMP() ON UPDATE CURRENT_TIMESTAMP(),
  PRIMARY KEY (`uuid`),
  UNIQUE KEY `uk_positions_code` (`position_code`),
  UNIQUE KEY `uk_leave_policies_type` (`leave_type_uuid`),
  CONSTRAINT `fk_leave_policies_type` FOREIGN KEY (`leave_type_uuid`) REFERENCES `LeaveTypes` (`uuid`) ON DELETE RESTRICT
) ENGINE=InnoDB DEFAULT CHARSET=utf8mb4 COLLATE=utf8mb4_unicode_ci
COMMENT='Leave policies with entitlement calculation rules';

--
-- Table: BudgetYears
-- Purpose: Organizational budget years for leave tracking
-- 1NF: ✓ Atomic values
-- 2NF: ✓ Single-column PK
-- 3NF: ✓ No transitive dependencies
--
DROP TABLE IF EXISTS `BudgetYears`;
CREATE TABLE `BudgetYears` (
  `uuid` VARCHAR(36) NOT NULL,
  `year` INT NOT NULL,
  `start_date` DATE NOT NULL,
  `end_date` DATE NOT NULL,
  `status` ENUM('DRAFT','ACTIVE','CLOSED') NOT NULL DEFAULT 'DRAFT',
  `created_at` DATETIME NOT NULL DEFAULT CURRENT_TIMESTAMP(),
  `updated_at` DATETIME NOT NULL DEFAULT CURRENT_TIMESTAMP() ON UPDATE CURRENT_TIMESTAMP(),
  PRIMARY KEY (`uuid`),
  UNIQUE KEY `uk_positions_code` (`position_code`),
  UNIQUE KEY `uk_budget_years_year` (`year`),
  KEY `idx_budget_years_status` (`status`),
  CONSTRAINT `chk_budget_years_dates` CHECK (`end_date` > `start_date`)
) ENGINE=InnoDB DEFAULT CHARSET=utf8mb4 COLLATE=utf8mb4_unicode_ci
COMMENT='Organizational budget years for leave and fiscal tracking';

--
-- Table: EmployeeLeaveBalances
-- Purpose: Employee leave balances per budget year
-- 1NF: ✓ Atomic values
-- 2NF: ✓ All attributes depend on composite key (employee, budget_year)
-- 3NF: ✓ No transitive dependencies
-- IMPROVEMENT: Changed budgetYear VARCHAR to budget_year_uuid FK
--
DROP TABLE IF EXISTS `EmployeeLeaveBalances`;
CREATE TABLE `EmployeeLeaveBalances` (
  `uuid` VARCHAR(36) NOT NULL,
  `employee_uuid` VARCHAR(36) NOT NULL,
  `budget_year_uuid` VARCHAR(36) NOT NULL,
  `leave_type_uuid` VARCHAR(36) NOT NULL COMMENT 'Leave type for this balance',
  `entitled_days` DECIMAL(8,1) NOT NULL,
  `carried_forward_days` DECIMAL(8,1) NOT NULL DEFAULT 0.0,
  `used_days` DECIMAL(8,1) NOT NULL DEFAULT 0.0,
  `remaining_days` DECIMAL(8,1) NOT NULL,
  `status` ENUM('ACTIVE','INACTIVE') NOT NULL DEFAULT 'ACTIVE',
  `updated_at` DATETIME NOT NULL DEFAULT CURRENT_TIMESTAMP() ON UPDATE CURRENT_TIMESTAMP(),
  PRIMARY KEY (`uuid`),
  UNIQUE KEY `uk_positions_code` (`position_code`),
  UNIQUE KEY `uk_balance_employee_year_type` (`employee_uuid`, `budget_year_uuid`, `leave_type_uuid`),
  KEY `idx_balance_employee` (`employee_uuid`),
  KEY `idx_balance_budget_year` (`budget_year_uuid`),
  KEY `idx_balance_leave_type` (`leave_type_uuid`),
  KEY `idx_balance_status` (`status`),
  CONSTRAINT `fk_leave_balances_employee` FOREIGN KEY (`employee_uuid`) REFERENCES `Employees` (`uuid`) ON DELETE CASCADE,
  CONSTRAINT `fk_leave_balances_budget_year` FOREIGN KEY (`budget_year_uuid`) REFERENCES `BudgetYears` (`uuid`) ON DELETE RESTRICT,
  CONSTRAINT `fk_leave_balances_leave_type` FOREIGN KEY (`leave_type_uuid`) REFERENCES `LeaveTypes` (`uuid`) ON DELETE RESTRICT
) ENGINE=InnoDB DEFAULT CHARSET=utf8mb4 COLLATE=utf8mb4_unicode_ci
COMMENT='Employee leave balances with proper foreign key references';

--
-- Table: LeavePostponements
-- Purpose: Leave postponement approvals
-- 1NF: ✓ Atomic values
-- 2NF: ✓ All attributes depend on PK
-- 3NF: ✓ No transitive dependencies
--
DROP TABLE IF EXISTS `LeavePostponements`;
CREATE TABLE `LeavePostponements` (
  `uuid` VARCHAR(36) NOT NULL,
  `employee_uuid` VARCHAR(36) NOT NULL,
  `leave_balance_uuid` VARCHAR(36) NOT NULL,
  `postponed_days` DECIMAL(8,1) NOT NULL,
  `reason` TEXT DEFAULT NULL,
  `status` ENUM('PENDING','APPROVED','REJECTED') NOT NULL DEFAULT 'PENDING',
  `approved_by_uuid` VARCHAR(36) DEFAULT NULL,
  `approved_at` DATETIME DEFAULT NULL,
  `created_at` DATETIME NOT NULL DEFAULT CURRENT_TIMESTAMP(),
  PRIMARY KEY (`uuid`),
  UNIQUE KEY `uk_positions_code` (`position_code`),
  KEY `idx_postponements_employee` (`employee_uuid`),
  KEY `idx_postponements_balance` (`leave_balance_uuid`),
  KEY `idx_postponements_status` (`status`),
  KEY `idx_postponements_approved_by` (`approved_by_uuid`),
  CONSTRAINT `fk_postponements_employee` FOREIGN KEY (`employee_uuid`) REFERENCES `Employees` (`uuid`) ON DELETE CASCADE,
  CONSTRAINT `fk_postponements_balance` FOREIGN KEY (`leave_balance_uuid`) REFERENCES `EmployeeLeaveBalances` (`uuid`) ON DELETE CASCADE,
  CONSTRAINT `fk_postponements_approved_by` FOREIGN KEY (`approved_by_uuid`) REFERENCES `Users` (`uuid`) ON DELETE SET NULL
) ENGINE=InnoDB DEFAULT CHARSET=utf8mb4 COLLATE=utf8mb4_unicode_ci
COMMENT='Leave postponement requests and approvals';

--
-- Table: LeaveRequests
-- Purpose: Employee leave requests
-- 1NF: ✓ Atomic values (dailyPlanJson represents single daily pattern)
-- 2NF: ✓ All attributes depend on PK
-- 3NF: ✓ No transitive dependencies
-- IMPROVEMENT: Changed leaveType VARCHAR to leave_type_uuid FK
--
DROP TABLE IF EXISTS `LeaveRequests`;
CREATE TABLE `LeaveRequests` (
  `uuid` VARCHAR(36) NOT NULL,
  `employee_uuid` VARCHAR(36) NOT NULL,
  `leave_type_uuid` VARCHAR(36) NOT NULL,
  `start_date` DATE NOT NULL,
  `end_date` DATE NOT NULL,
  `total_days` DECIMAL(8,1) NOT NULL,
  `day_pattern` VARCHAR(20) DEFAULT NULL COMMENT 'FULL_DAYS, HALF_DAYS, CUSTOM',
  `daily_plan_json` JSON DEFAULT NULL COMMENT 'Daily breakdown for custom patterns',
  `reason` TEXT DEFAULT NULL,
  `rejection_reason` TEXT DEFAULT NULL,
  `status` ENUM('PENDING','PENDING_DEPARTMENT','PENDING_HR','APPROVED','REJECTED','REJECTED_DEPARTMENT','REJECTED_HR','CANCELLED') NOT NULL DEFAULT 'PENDING_DEPARTMENT',
  `department_approved_by_uuid` VARCHAR(36) DEFAULT NULL,
  `department_approved_at` DATETIME DEFAULT NULL,
  `hr_approved_by_uuid` VARCHAR(36) DEFAULT NULL,
  `hr_approved_at` DATETIME DEFAULT NULL,
  `cancelled_at` DATETIME DEFAULT NULL,
  `cancelled_by_uuid` VARCHAR(36) DEFAULT NULL,
  `original_end_date` DATE DEFAULT NULL COMMENT 'Original end date if leave was shortened',
  `actual_return_date` DATE DEFAULT NULL,
  `is_shortened` TINYINT(1) NOT NULL DEFAULT 0,
  `shortened_at` DATETIME DEFAULT NULL,
  `shortened_by_uuid` VARCHAR(36) DEFAULT NULL,
  `created_at` DATETIME NOT NULL DEFAULT CURRENT_TIMESTAMP(),
  `updated_at` DATETIME NOT NULL DEFAULT CURRENT_TIMESTAMP() ON UPDATE CURRENT_TIMESTAMP(),
  PRIMARY KEY (`uuid`),
  UNIQUE KEY `uk_positions_code` (`position_code`),
  KEY `idx_leave_requests_employee` (`employee_uuid`),
  KEY `idx_leave_requests_type` (`leave_type_uuid`),
  KEY `idx_leave_requests_status` (`status`),
  KEY `idx_leave_requests_dates` (`start_date`, `end_date`),
  KEY `idx_leave_requests_dept_approved` (`department_approved_by_uuid`),
  KEY `idx_leave_requests_hr_approved` (`hr_approved_by_uuid`),
  KEY `idx_leave_requests_cancelled` (`cancelled_by_uuid`),
  KEY `idx_leave_requests_shortened` (`shortened_by_uuid`),
  CONSTRAINT `fk_leave_requests_employee` FOREIGN KEY (`employee_uuid`) REFERENCES `Employees` (`uuid`) ON DELETE CASCADE,
  CONSTRAINT `fk_leave_requests_type` FOREIGN KEY (`leave_type_uuid`) REFERENCES `LeaveTypes` (`uuid`) ON DELETE RESTRICT,
  CONSTRAINT `fk_leave_requests_dept_approved` FOREIGN KEY (`department_approved_by_uuid`) REFERENCES `Users` (`uuid`) ON DELETE SET NULL,
  CONSTRAINT `fk_leave_requests_hr_approved` FOREIGN KEY (`hr_approved_by_uuid`) REFERENCES `Users` (`uuid`) ON DELETE SET NULL,
  CONSTRAINT `fk_leave_requests_cancelled` FOREIGN KEY (`cancelled_by_uuid`) REFERENCES `Users` (`uuid`) ON DELETE SET NULL,
  CONSTRAINT `fk_leave_requests_shortened` FOREIGN KEY (`shortened_by_uuid`) REFERENCES `Users` (`uuid`) ON DELETE SET NULL,
  CONSTRAINT `chk_leave_requests_dates` CHECK (`end_date` >= `start_date`)
) ENGINE=InnoDB DEFAULT CHARSET=utf8mb4 COLLATE=utf8mb4_unicode_ci
COMMENT='Employee leave requests with proper type references';

--
-- Table: LeaveRequestDocuments
-- Purpose: Supporting documents for leave requests
-- 1NF: ✓ Atomic values
-- 2NF: ✓ All attributes depend on PK
-- 3NF: ✓ No transitive dependencies
--
DROP TABLE IF EXISTS `LeaveRequestDocuments`;
CREATE TABLE `LeaveRequestDocuments` (
  `uuid` VARCHAR(36) NOT NULL,
  `leave_request_uuid` VARCHAR(36) NOT NULL,
  `employee_uuid` VARCHAR(36) NOT NULL,
  `original_name` VARCHAR(255) NOT NULL,
  `object_key` VARCHAR(512) NOT NULL COMMENT 'S3 key or file path',
  `mime_type` VARCHAR(120) NOT NULL,
  `size_bytes` BIGINT NOT NULL,
  `created_at` DATETIME NOT NULL DEFAULT CURRENT_TIMESTAMP(),
  PRIMARY KEY (`uuid`),
  UNIQUE KEY `uk_positions_code` (`position_code`),
  KEY `idx_leave_docs_request` (`leave_request_uuid`),
  KEY `idx_leave_docs_employee` (`employee_uuid`),
  CONSTRAINT `fk_leave_docs_request` FOREIGN KEY (`leave_request_uuid`) REFERENCES `LeaveRequests` (`uuid`) ON DELETE CASCADE,
  CONSTRAINT `fk_leave_docs_employee` FOREIGN KEY (`employee_uuid`) REFERENCES `Employees` (`uuid`) ON DELETE CASCADE
) ENGINE=InnoDB DEFAULT CHARSET=utf8mb4 COLLATE=utf8mb4_unicode_ci
COMMENT='Supporting documents for leave requests';

