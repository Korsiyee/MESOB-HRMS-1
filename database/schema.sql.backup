  CONSTRAINT `fk_issued_letters_template` FOREIGN KEY (`template_uuid`) REFERENCES `LetterTemplates` (`uuid`) ON DELETE RESTRICT,
  CONSTRAINT `fk_issued_letters_issued_by` FOREIGN KEY (`issued_by_uuid`) REFERENCES `Users` (`uuid`) ON DELETE SET NULL
) ENGINE=InnoDB DEFAULT CHARSET=utf8mb4 COLLATE=utf8mb4_unicode_ci
COMMENT='Issued letters to employees';

--
-- Table: LetterReferenceSequence
-- Purpose: Sequence generator for letter reference numbers
-- 1NF: ✓ Atomic values
-- 2NF: ✓ All attributes depend on PK
-- 3NF: ✓ No transitive dependencies
--
DROP TABLE IF EXISTS `LetterReferenceSequence`;
CREATE TABLE `LetterReferenceSequence` (
  `id` INT NOT NULL AUTO_INCREMENT,
  `year` INT NOT NULL,
  `sequence_number` INT NOT NULL,
  `letter_type` VARCHAR(100) DEFAULT NULL,
  `generated_ref_no` VARCHAR(100) DEFAULT NULL,
  `letter_uuid` VARCHAR(36) DEFAULT NULL,
  `created_at` DATETIME NOT NULL DEFAULT CURRENT_TIMESTAMP(),
  PRIMARY KEY (`id`),
  KEY `idx_letter_ref_year` (`year`),
  KEY `idx_letter_ref_type` (`letter_type`)
) ENGINE=InnoDB DEFAULT CHARSET=utf8mb4 COLLATE=utf8mb4_unicode_ci
COMMENT='Sequence generator for letter reference numbers';

-- ============================================================================
-- SECTION 9: NOTIFICATIONS AND AUDIT
-- ============================================================================

--
-- Table: Notifications
-- Purpose: User notifications
-- 1NF: ✓ Atomic values
-- 2NF: ✓ All attributes depend on PK
-- 3NF: ✓ No transitive dependencies
-- IMPROVEMENT: Removed sender_role VARCHAR (redundant with sender's role)
--
DROP TABLE IF EXISTS `Notifications`;
CREATE TABLE `Notifications` (
  `uuid` VARCHAR(36) NOT NULL,
  `recipient_uuid` VARCHAR(36) NOT NULL,
  `sender_uuid` VARCHAR(36) DEFAULT NULL,
  `notification_type` VARCHAR(80) NOT NULL,
  `title` VARCHAR(255) NOT NULL,
  `message` TEXT NOT NULL,
  `redirect_url` VARCHAR(500) DEFAULT NULL,
  `entity_type` VARCHAR(50) DEFAULT NULL COMMENT 'Type of related entity',
  `entity_uuid` VARCHAR(50) DEFAULT NULL COMMENT 'UUID of related entity',
  `is_read` TINYINT(1) NOT NULL DEFAULT 0,
  `created_at` DATETIME NOT NULL DEFAULT CURRENT_TIMESTAMP(),
  PRIMARY KEY (`uuid`),
  UNIQUE KEY `uk_positions_code` (`position_code`),
  KEY `idx_notifications_recipient` (`recipient_uuid`),
  KEY `idx_notifications_sender` (`sender_uuid`),
  KEY `idx_notifications_unread` (`recipient_uuid`, `is_read`),
  KEY `idx_notifications_type` (`notification_type`),
  KEY `idx_notifications_created` (`created_at`),
  CONSTRAINT `fk_notifications_recipient` FOREIGN KEY (`recipient_uuid`) REFERENCES `Users` (`uuid`) ON DELETE CASCADE,
  CONSTRAINT `fk_notifications_sender` FOREIGN KEY (`sender_uuid`) REFERENCES `Users` (`uuid`) ON DELETE SET NULL
) ENGINE=InnoDB DEFAULT CHARSET=utf8mb4 COLLATE=utf8mb4_unicode_ci
COMMENT='User notifications without redundant sender_role field';

--
-- Table: AuditLogs
-- Purpose: General audit trail for entity changes
-- 1NF: ✓ Atomic values (diff_json represents single change event)
-- 2NF: ✓ All attributes depend on PK
-- 3NF: ✓ No transitive dependencies
--
DROP TABLE IF EXISTS `AuditLogs`;
CREATE TABLE `AuditLogs` (
  `uuid` VARCHAR(36) NOT NULL,
  `actor_uuid` VARCHAR(36) DEFAULT NULL,
  `action` VARCHAR(100) NOT NULL,
  `entity_type` VARCHAR(100) DEFAULT NULL,
  `entity_uuid` VARCHAR(36) DEFAULT NULL,
  `diff_json` JSON DEFAULT NULL COMMENT 'Before/after values',
  `ip_address` VARCHAR(45) DEFAULT NULL,
  `created_at` DATETIME NOT NULL DEFAULT CURRENT_TIMESTAMP(),
  PRIMARY KEY (`uuid`),
  UNIQUE KEY `uk_positions_code` (`position_code`),
  KEY `idx_audit_logs_actor` (`actor_uuid`),
  KEY `idx_audit_logs_action` (`action`),
  KEY `idx_audit_logs_entity` (`entity_type`, `entity_uuid`),
  KEY `idx_audit_logs_created` (`created_at`),
  CONSTRAINT `fk_audit_logs_actor` FOREIGN KEY (`actor_uuid`) REFERENCES `Users` (`uuid`) ON DELETE SET NULL
) ENGINE=InnoDB DEFAULT CHARSET=utf8mb4 COLLATE=utf8mb4_unicode_ci
COMMENT='General audit trail for entity changes';

--
-- Table: AccessAuditLogs
-- Purpose: Detailed access control audit trail
-- 1NF: ✓ Atomic values
-- 2NF: ✓ All attributes depend on PK
-- 3NF: ✓ No transitive dependencies
--
DROP TABLE IF EXISTS `AccessAuditLogs`;
CREATE TABLE `AccessAuditLogs` (
  `uuid` VARCHAR(36) NOT NULL,
  `actor_user_uuid` VARCHAR(36) DEFAULT NULL,
  `target_user_uuid` VARCHAR(36) DEFAULT NULL,
  `action_type` ENUM(
    'ROLE_OCCUPATION_ASSIGNED','ROLE_OCCUPATION_REMOVED',
    'USER_OCCUPATION_ASSIGNED','USER_OCCUPATION_REMOVED',
    'SCOPE_ASSIGNED','SCOPE_REMOVED',
    'DELEGATION_CREATED','DELEGATION_REVOKED',
    'AUTHORIZATION_DENIED','TOKEN_REVOKED',
    'PERMISSION_CHECKED','PERMISSION_GRANTED','PERMISSION_DENIED',
    'SCOPE_VIOLATION','LOGIN_FAILURE','TOKEN_REFRESH',
    'DELEGATION_EXPIRED','PERMISSION_EXPIRED',
    'PERMISSION_OVERRIDE_ADDED','PERMISSION_OVERRIDE_REMOVED'
  ) NOT NULL,
  `resource_type` VARCHAR(50) DEFAULT NULL,
  `resource_uuid` VARCHAR(255) DEFAULT NULL,
  `old_value` TEXT DEFAULT NULL,
  `new_value` TEXT DEFAULT NULL,
  `reason` TEXT DEFAULT NULL,
  `ip_address` VARCHAR(45) DEFAULT NULL,
  `user_agent` TEXT DEFAULT NULL,
  `created_at` DATETIME NOT NULL DEFAULT CURRENT_TIMESTAMP(),
  PRIMARY KEY (`uuid`),
  UNIQUE KEY `uk_positions_code` (`position_code`),
  KEY `idx_access_audit_actor` (`actor_user_uuid`, `created_at`),
  KEY `idx_access_audit_target` (`target_user_uuid`, `created_at`),
  KEY `idx_access_audit_action` (`action_type`, `created_at`),
  KEY `idx_access_audit_created` (`created_at`)
) ENGINE=InnoDB DEFAULT CHARSET=utf8mb4 COLLATE=utf8mb4_unicode_ci
COMMENT='Detailed access control and authorization audit trail';

