--
-- Table: LetterLayoutConfig
-- Purpose: Letter layout configuration
-- 1NF: ✓ Atomic values
-- 2NF: ✓ Single-column PK
-- 3NF: ✓ No transitive dependencies
--
DROP TABLE IF EXISTS `LetterLayoutConfig`;
CREATE TABLE `LetterLayoutConfig` (
  `uuid` VARCHAR(36) NOT NULL,
  `layout_name` VARCHAR(100) NOT NULL,
  `margin_top` INT DEFAULT NULL,
  `margin_bottom` INT DEFAULT NULL,
  `margin_left` INT DEFAULT NULL,
  `margin_right` INT DEFAULT NULL,
  `header_height` INT DEFAULT NULL,
  `footer_height` INT DEFAULT NULL,
  `font_family` VARCHAR(100) DEFAULT NULL,
  `font_size` INT DEFAULT NULL,
  `is_active` TINYINT(1) NOT NULL DEFAULT 1,
  `created_at` DATETIME NOT NULL DEFAULT CURRENT_TIMESTAMP(),
  `updated_at` DATETIME NOT NULL DEFAULT CURRENT_TIMESTAMP() ON UPDATE CURRENT_TIMESTAMP(),
  PRIMARY KEY (`uuid`),
  UNIQUE KEY `uk_positions_code` (`position_code`),
  UNIQUE KEY `uk_letter_layout_name` (`layout_name`),
  KEY `idx_letter_layout_active` (`is_active`)
) ENGINE=InnoDB DEFAULT CHARSET=utf8mb4 COLLATE=utf8mb4_unicode_ci
COMMENT='Letter layout configuration for PDF generation';

--
-- Table: LetterTemplates
-- Purpose: Letter templates
-- 1NF: ✓ Atomic values
-- 2NF: ✓ All attributes depend on PK
-- 3NF: ✓ No transitive dependencies
--
DROP TABLE IF EXISTS `LetterTemplates`;
CREATE TABLE `LetterTemplates` (
  `uuid` VARCHAR(36) NOT NULL,
  `type` VARCHAR(100) NOT NULL,
  `title` VARCHAR(200) NOT NULL,
  `category` VARCHAR(50) NOT NULL DEFAULT 'GENERAL',
  `body_template` TEXT DEFAULT NULL,
  `text_content` LONGTEXT DEFAULT NULL,
  `pdf_template_key` VARCHAR(500) DEFAULT NULL,
  `original_filename` VARCHAR(255) DEFAULT NULL,
  `file_size` BIGINT DEFAULT NULL,
  `mime_type` VARCHAR(120) DEFAULT NULL,
  `recipient_info` TEXT DEFAULT NULL,
  `subject` TEXT DEFAULT NULL,
  `main_body` TEXT DEFAULT NULL,
  `closing_text` TEXT DEFAULT NULL,
  `cc_recipients` TEXT DEFAULT NULL,
  `uses_new_format` TINYINT(1) NOT NULL DEFAULT 1,
  `is_active` TINYINT(1) NOT NULL DEFAULT 1,
  `layout_config_uuid` VARCHAR(36) DEFAULT NULL,
  `created_by_uuid` VARCHAR(36) DEFAULT NULL,
  `created_at` DATETIME NOT NULL DEFAULT CURRENT_TIMESTAMP(),
  `updated_at` DATETIME NOT NULL DEFAULT CURRENT_TIMESTAMP() ON UPDATE CURRENT_TIMESTAMP(),
  PRIMARY KEY (`uuid`),
  UNIQUE KEY `uk_positions_code` (`position_code`),
  KEY `idx_letter_templates_type` (`type`),
  KEY `idx_letter_templates_category` (`category`),
  KEY `idx_letter_templates_active` (`is_active`),
  KEY `idx_letter_templates_layout` (`layout_config_uuid`),
  KEY `idx_letter_templates_created_by` (`created_by_uuid`),
  CONSTRAINT `fk_letter_templates_layout` FOREIGN KEY (`layout_config_uuid`) REFERENCES `LetterLayoutConfig` (`uuid`) ON DELETE SET NULL,
  CONSTRAINT `fk_letter_templates_created_by` FOREIGN KEY (`created_by_uuid`) REFERENCES `Users` (`uuid`) ON DELETE SET NULL
) ENGINE=InnoDB DEFAULT CHARSET=utf8mb4 COLLATE=utf8mb4_unicode_ci
COMMENT='Letter templates for generating employee letters';

--
-- Table: LetterRequests
-- Purpose: Employee letter requests
-- 1NF: ✓ Atomic values
-- 2NF: ✓ All attributes depend on PK
-- 3NF: ✓ No transitive dependencies
--
DROP TABLE IF EXISTS `LetterRequests`;
CREATE TABLE `LetterRequests` (
  `uuid` VARCHAR(36) NOT NULL,
  `employee_uuid` VARCHAR(36) NOT NULL,
  `template_uuid` VARCHAR(36) NOT NULL,
  `recipient_info` TEXT DEFAULT NULL,
  `subject` TEXT DEFAULT NULL,
  `main_body` TEXT DEFAULT NULL,
  `closing_text` TEXT DEFAULT NULL,
  `cc_recipients` TEXT DEFAULT NULL,
  `generated_content` LONGTEXT DEFAULT NULL,
  `generated_pdf_key` VARCHAR(500) DEFAULT NULL,
  `status` ENUM('PENDING','APPROVED','REJECTED') NOT NULL DEFAULT 'PENDING',
  `requested_at` DATETIME NOT NULL DEFAULT CURRENT_TIMESTAMP(),
  `reviewed_by_uuid` VARCHAR(36) DEFAULT NULL,
  `reviewed_at` DATETIME DEFAULT NULL,
  `rejection_reason` TEXT DEFAULT NULL,
  PRIMARY KEY (`uuid`),
  UNIQUE KEY `uk_positions_code` (`position_code`),
  KEY `idx_letter_requests_employee` (`employee_uuid`),
  KEY `idx_letter_requests_template` (`template_uuid`),
  KEY `idx_letter_requests_status` (`status`),
  KEY `idx_letter_requests_requested_at` (`requested_at`),
  KEY `idx_letter_requests_reviewed_by` (`reviewed_by_uuid`),
  CONSTRAINT `fk_letter_requests_employee` FOREIGN KEY (`employee_uuid`) REFERENCES `Employees` (`uuid`) ON DELETE CASCADE,
  CONSTRAINT `fk_letter_requests_template` FOREIGN KEY (`template_uuid`) REFERENCES `LetterTemplates` (`uuid`) ON DELETE RESTRICT,
  CONSTRAINT `fk_letter_requests_reviewed_by` FOREIGN KEY (`reviewed_by_uuid`) REFERENCES `Users` (`uuid`) ON DELETE SET NULL
) ENGINE=InnoDB DEFAULT CHARSET=utf8mb4 COLLATE=utf8mb4_unicode_ci
COMMENT='Employee letter requests';

--
-- Table: IssuedLetters
-- Purpose: Issued letters to employees
-- 1NF: ✓ Atomic values
-- 2NF: ✓ All attributes depend on PK
-- 3NF: ✓ No transitive dependencies
--
DROP TABLE IF EXISTS `IssuedLetters`;
CREATE TABLE `IssuedLetters` (
