
-- ============================================================================
-- SECTION 1: CORE RBAC TABLES
-- ============================================================================

-- DEPRECATED: Will be removed
  DROP TABLE IF EXISTS `Scopes`;
-- CREATE TABLE `Scopes` (
  `uuid` VARCHAR(36) NOT NULL,
  `code` VARCHAR(50) NOT NULL,
  `name` VARCHAR(100) NOT NULL,
  `description` TEXT DEFAULT NULL,
  `level` INT NOT NULL DEFAULT 0 COMMENT 'Hierarchy level for scope ordering',
  `created_at` DATETIME NOT NULL DEFAULT CURRENT_TIMESTAMP(),
  PRIMARY KEY (`uuid`),
  UNIQUE KEY `uk_positions_code` (`position_code`),
  UNIQUE KEY `uk_scopes_code` (`code`),
  KEY `idx_scopes_level` (`level`)
) ENGINE=InnoDB DEFAULT CHARSET=utf8mb4 COLLATE=utf8mb4_unicode_ci
COMMENT='Authorization scopes defining the reach of permissions';

--
-- Table: Modules
-- Purpose: System modules (Employee, Leave, Attendance, etc.)
-- 1NF: ✓ Atomic values
-- 2NF: ✓ Single-column PK
-- 3NF: ✓ No transitive dependencies
--
DROP TABLE IF EXISTS `Modules`;
CREATE TABLE `Modules` (
  `uuid` VARCHAR(36) NOT NULL,
  `code` VARCHAR(50) NOT NULL,
  `name` VARCHAR(100) NOT NULL,
  `description` TEXT DEFAULT NULL,
  `icon` VARCHAR(50) DEFAULT NULL,
  `display_order` INT NOT NULL DEFAULT 0,
  `is_active` TINYINT(1) NOT NULL DEFAULT 1,
  `created_at` DATETIME NOT NULL DEFAULT CURRENT_TIMESTAMP(),
  `updated_at` DATETIME NOT NULL DEFAULT CURRENT_TIMESTAMP() ON UPDATE CURRENT_TIMESTAMP(),
  PRIMARY KEY (`uuid`),
  UNIQUE KEY `uk_positions_code` (`position_code`),
  UNIQUE KEY `uk_modules_code` (`code`),
  KEY `idx_modules_active` (`is_active`),
  KEY `idx_modules_display_order` (`display_order`)
) ENGINE=InnoDB DEFAULT CHARSET=utf8mb4 COLLATE=utf8mb4_unicode_ci
COMMENT='System modules representing functional areas';

--
-- Table: Actions
-- Purpose: Granular actions (VIEW, CREATE, UPDATE, DELETE, APPROVE, REJECT, EXPORT)
-- 1NF: ✓ Atomic values
-- 2NF: ✓ Single-column PK
-- 3NF: ✓ No transitive dependencies
-- IMPROVEMENT: NEW TABLE - Previously actions were implicit, now explicit
--
-- DEPRECATED: Will be removed
-- DROP TABLE IF EXISTS `Actions`;
-- DEPRECATED: To be consolidated into other tables
-- CREATE TABLE `Actions` (
  `uuid` VARCHAR(36) NOT NULL,
  `code` VARCHAR(50) NOT NULL,
  `name` VARCHAR(100) NOT NULL,
  `description` TEXT DEFAULT NULL,
  `is_active` TINYINT(1) NOT NULL DEFAULT 1,
  `created_at` DATETIME NOT NULL DEFAULT CURRENT_TIMESTAMP(),
  PRIMARY KEY (`uuid`),
  UNIQUE KEY `uk_positions_code` (`position_code`),
  UNIQUE KEY `uk_actions_code` (`code`),
  KEY `idx_actions_active` (`is_active`)
) ENGINE=InnoDB DEFAULT CHARSET=utf8mb4 COLLATE=utf8mb4_unicode_ci
COMMENT='Available actions for permission control (VIEW, CREATE, UPDATE, DELETE, APPROVE, etc.)';

--
-- Table: Roles
-- Purpose: User roles in the system
-- 1NF: ✓ Atomic values
-- 2NF: ✓ Single-column PK
-- 3NF: ✓ No transitive dependencies (removed default_scope_uuid as it's context-dependent)
--
DROP TABLE IF EXISTS `Roles`;
CREATE TABLE `Roles` (
  `uuid` VARCHAR(36) NOT NULL,
  `code` VARCHAR(50) NOT NULL,
  `name` VARCHAR(100) NOT NULL,
  `description` TEXT DEFAULT NULL,
  `hierarchy_level` INT NOT NULL DEFAULT 10 COMMENT 'Higher number = more authority',
  `is_system_role` TINYINT(1) NOT NULL DEFAULT 0 COMMENT 'System roles cannot be deleted',
  `is_active` TINYINT(1) NOT NULL DEFAULT 1,
  `created_at` DATETIME NOT NULL DEFAULT CURRENT_TIMESTAMP(),
  `updated_at` DATETIME NOT NULL DEFAULT CURRENT_TIMESTAMP() ON UPDATE CURRENT_TIMESTAMP(),
  PRIMARY KEY (`uuid`),
  UNIQUE KEY `uk_positions_code` (`position_code`),
  UNIQUE KEY `uk_roles_code` (`code`),
  KEY `idx_roles_active` (`is_active`),
  KEY `idx_roles_hierarchy` (`hierarchy_level`)
) ENGINE=InnoDB DEFAULT CHARSET=utf8mb4 COLLATE=utf8mb4_unicode_ci
COMMENT='User roles defining what users are allowed to do';

--
-- Table: RolePermissions
-- Purpose: Junction table with granular permissions (Role + Module + Action + Scope)
-- 1NF: ✓ Atomic values
-- 2NF: ✓ All attributes depend on entire composite key (role, module, action)
-- 3NF: ✓ No transitive dependencies
-- IMPROVEMENT: Replaces RoleModules, adds Action dimension for granularity
--
DROP TABLE IF EXISTS `RolePermissions`;
CREATE TABLE `RolePermissions` (
  `uuid` VARCHAR(36) NOT NULL,
  `role_uuid` VARCHAR(36) NOT NULL,
  `module_uuid` VARCHAR(36) NOT NULL,
  `action_uuid` VARCHAR(36) NOT NULL,
  `scope_uuid` VARCHAR(36) NOT NULL,
  `created_at` DATETIME NOT NULL DEFAULT CURRENT_TIMESTAMP(),
  PRIMARY KEY (`uuid`),
  UNIQUE KEY `uk_positions_code` (`position_code`),
  UNIQUE KEY `uk_role_module_action` (`role_uuid`, `module_uuid`, `action_uuid`),
  KEY `idx_rp_role` (`role_uuid`),
  KEY `idx_rp_module` (`module_uuid`),
  KEY `idx_rp_action` (`action_uuid`),
  KEY `idx_rp_scope` (`scope_uuid`),
  CONSTRAINT `fk_rp_role` FOREIGN KEY (`role_uuid`) REFERENCES `Roles` (`uuid`) ON DELETE CASCADE,
  CONSTRAINT `fk_rp_module` FOREIGN KEY (`module_uuid`) REFERENCES `Modules` (`uuid`) ON DELETE CASCADE,
  CONSTRAINT `fk_rp_action` FOREIGN KEY (`action_uuid`) REFERENCES `Actions` (`uuid`) ON DELETE CASCADE,
  CONSTRAINT `fk_rp_scope` FOREIGN KEY (`scope_uuid`) REFERENCES `Scopes` (`uuid`) ON DELETE RESTRICT
) ENGINE=InnoDB DEFAULT CHARSET=utf8mb4 COLLATE=utf8mb4_unicode_ci
COMMENT='Granular permissions: Role can perform Action on Module within Scope';

-- ============================================================================
-- SECTION 2: ORGANIZATION STRUCTURE
-- ============================================================================

--
-- Table: Departments
-- Purpose: Organizational departments with hierarchy
-- 1NF: ✓ Atomic values
-- 2NF: ✓ Single-column PK
-- 3NF: ✓ No transitive dependencies
--
DROP TABLE IF EXISTS `Departments`;
CREATE TABLE `Departments` (
  `uuid` VARCHAR(36) NOT NULL,
  `dept_code` VARCHAR(50) NOT NULL COMMENT 'Human-readable department code',
  `uuid` VARCHAR(36) NOT NULL,
  `name` VARCHAR(200) NOT NULL,
  `parent_uuid` VARCHAR(36) DEFAULT NULL COMMENT 'Self-referential for department hierarchy',
  `is_active` TINYINT(1) NOT NULL DEFAULT 1 COMMENT 'Department active status',
  `head_employee_uuid` VARCHAR(36) DEFAULT NULL COMMENT 'Current department head',
  `created_at` DATETIME NOT NULL DEFAULT CURRENT_TIMESTAMP(),
  `updated_at` DATETIME NOT NULL DEFAULT CURRENT_TIMESTAMP() ON UPDATE CURRENT_TIMESTAMP(),
  PRIMARY KEY (`uuid`),
  UNIQUE KEY `uk_positions_code` (`position_code`),
  UNIQUE KEY `uk_departments_code` (`dept_code`),
  UNIQUE KEY `uk_departments_name` (`name`),
  KEY `idx_departments_parent` (`parent_uuid`),
  KEY `idx_departments_head` (`head_employee_uuid`),
  CONSTRAINT `fk_departments_parent` FOREIGN KEY (`parent_uuid`) REFERENCES `Departments` (`uuid`) ON DELETE SET NULL,
  -- REMOVED for optimization: CONSTRAINT `fk_departments_head` FOREIGN KEY (`head_employee_uuid`) REFERENCES `Employees` (`uuid`) ON DELETE SET NULL
) ENGINE=InnoDB DEFAULT CHARSET=utf8mb4 COLLATE=utf8mb4_unicode_ci
COMMENT='Organizational departments with hierarchical structure';

-- ============================================================================
-- NEW TABLE: DepartmentLeadership (Breaks Circular Dependency)
-- ============================================================================
DROP TABLE IF EXISTS `DepartmentLeadership`;
CREATE TABLE `DepartmentLeadership` (
  `uuid` VARCHAR(36) NOT NULL,
  `department_uuid` VARCHAR(36) NOT NULL,
  `employee_uuid` VARCHAR(36) NOT NULL,
  `effective_from` DATE NOT NULL,
  `effective_to` DATE DEFAULT NULL COMMENT 'NULL means currently active',
  `appointed_by_uuid` VARCHAR(36) DEFAULT NULL,
  `appointment_reason` TEXT DEFAULT NULL,
  `created_at` DATETIME NOT NULL DEFAULT CURRENT_TIMESTAMP(),
  PRIMARY KEY (`uuid`),
  KEY `idx_dept_leadership_department` (`department_uuid`),
  KEY `idx_dept_leadership_employee` (`employee_uuid`),
  KEY `idx_dept_leadership_effective` (`department_uuid`, `effective_from`, `effective_to`),
  KEY `idx_dept_leadership_current` (`department_uuid`, `effective_to`),
  CONSTRAINT `fk_dept_leadership_department` FOREIGN KEY (`department_uuid`) REFERENCES `Departments` (`uuid`) ON DELETE CASCADE,
  CONSTRAINT `fk_dept_leadership_employee` FOREIGN KEY (`employee_uuid`) REFERENCES `Employees` (`uuid`) ON DELETE CASCADE,
  CONSTRAINT `chk_dept_leadership_dates` CHECK (`effective_to` IS NULL OR `effective_to` >= `effective_from`)
) ENGINE=InnoDB DEFAULT CHARSET=utf8mb4 COLLATE=utf8mb4_unicode_ci
COMMENT='Department head assignments - BREAKS circular dependency';


--
-- Table: DepartmentLeadership (NEW)
-- Purpose: Historical department head assignments
-- IMPROVEMENT: Breaks circular dependency Departments ↔ Employees
--
DROP TABLE IF EXISTS `DepartmentLeadership`;
CREATE TABLE `DepartmentLeadership` (
  `uuid` VARCHAR(36) NOT NULL,
  `department_uuid` VARCHAR(36) NOT NULL,
  `employee_uuid` VARCHAR(36) NOT NULL,
  `effective_from` DATE NOT NULL,
  `effective_to` DATE DEFAULT NULL COMMENT 'NULL means currently active',
  `appointed_by_uuid` VARCHAR(36) DEFAULT NULL,
  `appointment_reason` TEXT DEFAULT NULL,
  `created_at` DATETIME NOT NULL DEFAULT CURRENT_TIMESTAMP(),
  PRIMARY KEY (`uuid`),
  UNIQUE KEY `uk_positions_code` (`position_code`),
  KEY `idx_dept_leadership_department` (`department_uuid`),
  KEY `idx_dept_leadership_employee` (`employee_uuid`),
  KEY `idx_dept_leadership_effective` (`department_uuid`, `effective_from`, `effective_to`),
  KEY `idx_dept_leadership_current` (`department_uuid`, `effective_to`),
  CONSTRAINT `fk_dept_leadership_department` FOREIGN KEY (`department_uuid`) REFERENCES `Departments` (`uuid`) ON DELETE CASCADE,
  CONSTRAINT `fk_dept_leadership_employee` FOREIGN KEY (`employee_uuid`) REFERENCES `Employees` (`uuid`) ON DELETE CASCADE,
  CONSTRAINT `chk_dept_leadership_dates` CHECK (`effective_to` IS NULL OR `effective_to` >= `effective_from`)
) ENGINE=InnoDB DEFAULT CHARSET=utf8mb4 COLLATE=utf8mb4_unicode_ci
COMMENT='Department head assignments - BREAKS circular dependency';



--
-- Table: ShiftDefinitions
-- Purpose: Work shift definitions
-- 1NF: ✓ Atomic values (working_days stored as JSON but represents a single schedule concept)
-- 2NF: ✓ Single-column PK
-- 3NF: ✓ No transitive dependencies
--
DROP TABLE IF EXISTS `ShiftDefinitions`;
CREATE TABLE `ShiftDefinitions` (
  `uuid` VARCHAR(36) NOT NULL,
  `shift_code` VARCHAR(50) NOT NULL COMMENT 'Human-readable shift code',
  `name` VARCHAR(100) NOT NULL,
  `start_time` TIME NOT NULL,
  `end_time` TIME NOT NULL,
  `working_days_json` JSON DEFAULT NULL COMMENT 'Array of working days, e.g., [1,2,3,4,5] for Mon-Fri',
  `grace_period_minutes` INT NOT NULL DEFAULT 15,
  `break_duration_minutes` INT NOT NULL DEFAULT 0,
  `created_at` DATETIME NOT NULL DEFAULT CURRENT_TIMESTAMP(),
  `updated_at` DATETIME NOT NULL DEFAULT CURRENT_TIMESTAMP() ON UPDATE CURRENT_TIMESTAMP(),
  PRIMARY KEY (`uuid`),
  UNIQUE KEY `uk_positions_code` (`position_code`),
  UNIQUE KEY `uk_shifts_name` (`name`)
) ENGINE=InnoDB DEFAULT CHARSET=utf8mb4 COLLATE=utf8mb4_unicode_ci
COMMENT='Shift definitions with working hours and schedules';

--
-- Table: Positions
-- Purpose: Job positions within departments
-- 1NF: ✓ Atomic values
-- 2NF: ✓ Single-column PK
-- 3NF: ✓ No transitive dependencies
--
DROP TABLE IF EXISTS `Positions`;
CREATE TABLE `Positions` (
  `uuid` VARCHAR(36) NOT NULL,
  `position_code` VARCHAR(50) NOT NULL COMMENT 'Human-readable position code',
  `title` VARCHAR(200) NOT NULL,
  `grade` VARCHAR(50) DEFAULT NULL,
  `occupation_type` VARCHAR(100) DEFAULT NULL COMMENT 'Professional occupation category',
  `department_uuid` VARCHAR(36) NOT NULL COMMENT 'Position belongs to exactly one department',
  `default_shift_uuid` VARCHAR(36) DEFAULT NULL COMMENT 'Default shift for this position',
  `created_at` DATETIME NOT NULL DEFAULT CURRENT_TIMESTAMP(),
  `updated_at` DATETIME NOT NULL DEFAULT CURRENT_TIMESTAMP() ON UPDATE CURRENT_TIMESTAMP(),
  PRIMARY KEY (`uuid`),
  UNIQUE KEY `uk_positions_code` (`position_code`),
  KEY `idx_positions_department` (`department_uuid`),
  KEY `idx_positions_default_shift` (`default_shift_uuid`),
  CONSTRAINT `fk_positions_department` FOREIGN KEY (`department_uuid`) REFERENCES `Departments` (`uuid`) ON DELETE RESTRICT,
  CONSTRAINT `fk_positions_default_shift` FOREIGN KEY (`default_shift_uuid`) REFERENCES `ShiftDefinitions` (`uuid`) ON DELETE SET NULL
) ENGINE=InnoDB DEFAULT CHARSET=utf8mb4 COLLATE=utf8mb4_unicode_ci
COMMENT='Job positions within organizational departments';

--
-- Table: Occupations
-- Purpose: Professional occupations/job functions
-- 1NF: ✓ Atomic values
-- 2NF: ✓ Single-column PK
-- 3NF: ✓ No transitive dependencies
--
-- DEPRECATED: Will be removed
-- DROP TABLE IF EXISTS `Occupations`;
-- DEPRECATED: To be consolidated into other tables
-- CREATE TABLE `Occupations` (
  `uuid` VARCHAR(36) NOT NULL,
  `code` VARCHAR(100) DEFAULT NULL,
  `name` VARCHAR(200) NOT NULL,
  `description` TEXT DEFAULT NULL,
  `created_at` DATETIME NOT NULL DEFAULT CURRENT_TIMESTAMP(),
  PRIMARY KEY (`uuid`),
  UNIQUE KEY `uk_positions_code` (`position_code`),
  UNIQUE KEY `uk_occupations_name` (`name`),
  UNIQUE KEY `uk_occupations_code` (`code`)
) ENGINE=InnoDB DEFAULT CHARSET=utf8mb4 COLLATE=utf8mb4_unicode_ci
COMMENT='Professional occupations independent of organizational structure';

--
-- Table: RoleOccupations
-- Purpose: Maps roles to occupations (many-to-many)
-- 1NF: ✓ Atomic values
-- 2NF: ✓ All attributes depend on entire composite key (role_uuid, occupation_uuid)
-- 3NF: ✓ No transitive dependencies
-- IMPROVEMENT: Changed role VARCHAR to role_uuid FK for proper normalization
--
-- DEPRECATED: Will be removed
-- DROP TABLE IF EXISTS `RoleOccupations`;
-- DEPRECATED: To be consolidated into other tables
-- CREATE TABLE `RoleOccupations` (
  `uuid` VARCHAR(36) NOT NULL,
  `role_uuid` VARCHAR(36) NOT NULL COMMENT 'Foreign key to Roles table',
  `occupation_uuid` VARCHAR(36) NOT NULL,
  `assigned_by_uuid` VARCHAR(36) DEFAULT NULL,
  `assigned_at` DATETIME NOT NULL DEFAULT CURRENT_TIMESTAMP(),
  `assigned_reason` TEXT DEFAULT NULL,
  PRIMARY KEY (`uuid`),
  UNIQUE KEY `uk_positions_code` (`position_code`),
  UNIQUE KEY `uk_role_occupation` (`role_uuid`, `occupation_uuid`),
  KEY `idx_role_occupations_role` (`role_uuid`),
  KEY `idx_role_occupations_occupation` (`occupation_uuid`),
  KEY `idx_role_occupations_assigned_by` (`assigned_by_uuid`),
  CONSTRAINT `fk_role_occupations_role` FOREIGN KEY (`role_uuid`) REFERENCES `Roles` (`uuid`) ON DELETE CASCADE,
  CONSTRAINT `fk_role_occupations_occupation` FOREIGN KEY (`occupation_uuid`) REFERENCES `Occupations` (`uuid`) ON DELETE CASCADE,
  CONSTRAINT `fk_role_occupations_assigned_by` FOREIGN KEY (`assigned_by_uuid`) REFERENCES `Users` (`uuid`) ON DELETE SET NULL
) ENGINE=InnoDB DEFAULT CHARSET=utf8mb4 COLLATE=utf8mb4_unicode_ci
COMMENT='Maps roles to occupations with proper referential integrity';

-- ============================================================================
-- SECTION 3: USERS AND AUTHENTICATION
-- ============================================================================

--
-- Table: Users
-- Purpose: System users with authentication
-- 1NF: ✓ Atomic values
-- 2NF: ✓ Single-column PK
-- 3NF: ✓ No transitive dependencies
-- IMPROVEMENT: Removed redundant 'role' VARCHAR, 'role_id' INT - use only role_uuid FK
--
DROP TABLE IF EXISTS `Users`;
CREATE TABLE `Users` (
  `uuid` VARCHAR(36) NOT NULL,
  `employee_uuid` VARCHAR(36) DEFAULT NULL COMMENT 'Link to employee record if applicable',
  `user_type` ENUM('EMPLOYEE','SYSTEM','SERVICE') NOT NULL DEFAULT 'EMPLOYEE' COMMENT 'User account type',
  `username` VARCHAR(100) NOT NULL,
  `password_hash` VARCHAR(255) NOT NULL,
  `refresh_token` TEXT DEFAULT NULL,
  `token_version` INT NOT NULL DEFAULT 0 COMMENT 'Increment to invalidate all tokens',
  `permissions_version` INT NOT NULL DEFAULT 1 COMMENT 'Cache invalidation counter - permissions from RolePermissions',
  `role_uuid` VARCHAR(36) NOT NULL COMMENT 'User primary role',
  `is_active` TINYINT(1) NOT NULL DEFAULT 1,
  `must_change_password` TINYINT(1) NOT NULL DEFAULT 0,
  `last_login` DATETIME DEFAULT NULL,
  `last_activity` DATETIME DEFAULT NULL,
  `created_at` DATETIME NOT NULL DEFAULT CURRENT_TIMESTAMP(),
  `updated_at` DATETIME NOT NULL DEFAULT CURRENT_TIMESTAMP() ON UPDATE CURRENT_TIMESTAMP(),
  PRIMARY KEY (`uuid`),
  UNIQUE KEY `uk_positions_code` (`position_code`),
  UNIQUE KEY `uk_users_username` (`username`),
  KEY `idx_users_employee` (`employee_uuid`),
  KEY `idx_users_role` (`role_uuid`),
  KEY `idx_users_active` (`is_active`),
  KEY `idx_users_permissions_version` (`permissions_version`),
  CONSTRAINT `fk_users_employee` FOREIGN KEY (`employee_uuid`) REFERENCES `Employees` (`uuid`) ON DELETE CASCADE,
  CONSTRAINT `fk_users_role` FOREIGN KEY (`role_uuid`) REFERENCES `Roles` (`uuid`) ON DELETE RESTRICT
  -- CONSTRAINT `chk_users_employee_type` CHECK ((user_type='EMPLOYEE' AND employee_uuid IS NOT NULL) OR (user_type IN ('SYSTEM','SERVICE') AND employee_uuid IS NULL)),
) ENGINE=InnoDB DEFAULT CHARSET=utf8mb4 COLLATE=utf8mb4_unicode_ci
COMMENT='System users with single authoritative role reference';

--
-- Table: UserScopes
-- Purpose: Additional scopes assigned to users beyond role defaults
-- 1NF: ✓ Atomic values
-- 2NF: ✓ All attributes depend on entire composite key
-- 3NF: ✓ No transitive dependencies
--
DROP TABLE IF EXISTS `UserScopes`;
CREATE TABLE `UserScopes` (
  `uuid` VARCHAR(36) NOT NULL,
  `user_uuid` VARCHAR(36) NOT NULL,
  `scope_type` ENUM('SELF','DEPARTMENT','BRANCH','COMPANY','ALL') NOT NULL,
  `scope_value` VARCHAR(36) DEFAULT NULL COMMENT 'UUID reference to department/branch if applicable',
  `assigned_by_uuid` VARCHAR(36) DEFAULT NULL,
  `assigned_at` DATETIME NOT NULL DEFAULT CURRENT_TIMESTAMP(),
  `assigned_reason` TEXT DEFAULT NULL,
  PRIMARY KEY (`uuid`),
  UNIQUE KEY `uk_positions_code` (`position_code`),
  KEY `idx_user_scopes_user` (`user_uuid`),
  KEY `idx_user_scopes_type` (`scope_type`),
  KEY `idx_user_scopes_assigned_by` (`assigned_by_uuid`),
  CONSTRAINT `fk_user_scopes_user` FOREIGN KEY (`user_uuid`) REFERENCES `Users` (`uuid`) ON DELETE CASCADE,
  CONSTRAINT `fk_user_scopes_assigned_by` FOREIGN KEY (`assigned_by_uuid`) REFERENCES `Users` (`uuid`) ON DELETE SET NULL
) ENGINE=InnoDB DEFAULT CHARSET=utf8mb4 COLLATE=utf8mb4_unicode_ci
COMMENT='Additional scope assignments for users beyond role defaults';

-- ============================================================================
-- SECTION 4: EMPLOYEE MANAGEMENT
-- ============================================================================

--
-- Table: Employees
-- Purpose: Core employee information (single source of truth)
-- 1NF: ✓ Atomic values
-- 2NF: ✓ Single-column PK
-- 3NF: ✓ No transitive dependencies
-- IMPROVEMENTS:
--   - Removed department_uuid (derived from position)
--   - Removed level_uuid (use EmployeeLevelHistory as source of truth)
--   - Removed occupation_uuid (use EmployeeOccupations as source of truth)
--   - Position is mandatory for organizational structure
--
DROP TABLE IF EXISTS `Employees`;
CREATE TABLE `Employees` (
  `uuid` VARCHAR(36) NOT NULL,
  `mesob_id` VARCHAR(20) DEFAULT NULL COMMENT 'Human-readable employee ID',
  `title` ENUM('Mr','Mrs','Ms','Dr','Prof','Ato','W/ro','W/t') DEFAULT NULL,
  `first_name` VARCHAR(100) NOT NULL,
  `middle_name` VARCHAR(100) NOT NULL,
  `last_name` VARCHAR(100) NOT NULL,
  `mother_name` VARCHAR(100) NOT NULL,
  `gender` ENUM('MALE','FEMALE') NOT NULL,
  `date_of_birth` DATE NOT NULL,
  `nationality` VARCHAR(100) NOT NULL DEFAULT 'Ethiopian',
  `profile_photo_key` VARCHAR(500) DEFAULT NULL COMMENT 'S3 key or file path',
  `tin_number` VARCHAR(50) DEFAULT NULL,
  `pension_code` VARCHAR(50) DEFAULT NULL,
  `bank_name` VARCHAR(200) DEFAULT NULL,
  `bank_account_number` VARCHAR(100) DEFAULT NULL,
  `hire_date` DATE NOT NULL,
  `prior_gov_service_years` DECIMAL(5,2) NOT NULL DEFAULT 0.00 COMMENT 'Years of prior government service',
  `status` ENUM('ACTIVE','INACTIVE','TERMINATED') NOT NULL DEFAULT 'ACTIVE',
  `attendance_exempt` TINYINT(1) NOT NULL DEFAULT 0 COMMENT 'True if employee is exempt from attendance tracking',
  `face_images_registered` TINYINT(1) NOT NULL DEFAULT 0 COMMENT 'True if face recognition images are registered',
  `position_uuid` VARCHAR(36) NOT NULL COMMENT 'Current position (determines department)',
  `created_at` DATETIME NOT NULL DEFAULT CURRENT_TIMESTAMP(),
  `updated_at` DATETIME NOT NULL DEFAULT CURRENT_TIMESTAMP() ON UPDATE CURRENT_TIMESTAMP(),
  PRIMARY KEY (`uuid`),
  UNIQUE KEY `uk_positions_code` (`position_code`),
  UNIQUE KEY `uk_employees_mesob_id` (`mesob_id`),
  KEY `idx_employees_name` (`last_name`, `first_name`),
  KEY `idx_employees_position` (`position_uuid`),
  KEY `idx_employees_status` (`status`),
  KEY `idx_employees_tin` (`tin_number`),
  KEY `idx_employees_hire_date` (`hire_date`),
  CONSTRAINT `fk_employees_position` FOREIGN KEY (`position_uuid`) REFERENCES `Positions` (`uuid`) ON DELETE RESTRICT
) ENGINE=InnoDB DEFAULT CHARSET=utf8mb4 COLLATE=utf8mb4_unicode_ci
COMMENT='Core employee information without redundant department/level/occupation references';

--
-- Table: EmployeeAddresses
-- Purpose: Employee address information
-- 1NF: ✓ Atomic values
-- 2NF: ✓ All attributes depend on PK
-- 3NF: ✓ No transitive dependencies
--
DROP TABLE IF EXISTS `EmployeeAddresses`;
CREATE TABLE `EmployeeAddresses` (
  `uuid` VARCHAR(36) NOT NULL,
  `employee_uuid` VARCHAR(36) NOT NULL,
  `address_type` ENUM('PERMANENT','CURRENT') NOT NULL,
  `region` VARCHAR(100) DEFAULT NULL,
  `zone` VARCHAR(100) DEFAULT NULL,
  `woreda` VARCHAR(100) DEFAULT NULL,
  `kebele` VARCHAR(100) DEFAULT NULL,
  `house_number` VARCHAR(50) DEFAULT NULL,
  `phone_primary` VARCHAR(20) DEFAULT NULL,
  `phone_secondary` VARCHAR(20) DEFAULT NULL,
  `email` VARCHAR(200) DEFAULT NULL,
  PRIMARY KEY (`uuid`),
  UNIQUE KEY `uk_positions_code` (`position_code`),
  KEY `idx_employee_addresses_employee` (`employee_uuid`),
  KEY `idx_employee_addresses_type` (`employee_uuid`, `address_type`),
  CONSTRAINT `fk_employee_addresses_employee` FOREIGN KEY (`employee_uuid`) REFERENCES `Employees` (`uuid`) ON DELETE CASCADE
) ENGINE=InnoDB DEFAULT CHARSET=utf8mb4 COLLATE=utf8mb4_unicode_ci
COMMENT='Employee address information';

--
-- Table: EmployeeIDDocuments
-- Purpose: Employee identification documents
-- 1NF: ✓ Atomic values
-- 2NF: ✓ All attributes depend on PK
-- 3NF: ✓ No transitive dependencies
--
DROP TABLE IF EXISTS `EmployeeIDDocuments`;
CREATE TABLE `EmployeeIDDocuments` (
  `uuid` VARCHAR(36) NOT NULL,
  `employee_uuid` VARCHAR(36) NOT NULL,
  `doc_type` VARCHAR(100) NOT NULL COMMENT 'e.g., Passport, National ID, Driver License',
  `id_number` VARCHAR(100) NOT NULL,
  `issue_date` DATE DEFAULT NULL,
  `valid_until` DATE DEFAULT NULL,
  `file_key` VARCHAR(500) DEFAULT NULL COMMENT 'S3 key or file path',
  `original_name` VARCHAR(255) DEFAULT NULL,
  `mime_type` VARCHAR(120) DEFAULT NULL,
  `file_size` BIGINT DEFAULT NULL,
  `created_at` DATETIME NOT NULL DEFAULT CURRENT_TIMESTAMP(),
  `updated_at` DATETIME NOT NULL DEFAULT CURRENT_TIMESTAMP() ON UPDATE CURRENT_TIMESTAMP(),
  PRIMARY KEY (`uuid`),
  UNIQUE KEY `uk_positions_code` (`position_code`),
  KEY `idx_employee_docs_employee` (`employee_uuid`),
  KEY `idx_employee_docs_type` (`employee_uuid`, `doc_type`),
  CONSTRAINT `fk_employee_docs_employee` FOREIGN KEY (`employee_uuid`) REFERENCES `Employees` (`uuid`) ON DELETE CASCADE
) ENGINE=InnoDB DEFAULT CHARSET=utf8mb4 COLLATE=utf8mb4_unicode_ci
COMMENT='Employee identification documents';

--
-- Table: EmployeeFaceImages
-- Purpose: Face recognition images for attendance
-- 1NF: ✓ Atomic values (descriptor_json represents single face encoding)
-- 2NF: ✓ All attributes depend on entire composite key
-- 3NF: ✓ No transitive dependencies
--
DROP TABLE IF EXISTS `EmployeeFaceImages`;
CREATE TABLE `EmployeeFaceImages` (
  `uuid` VARCHAR(36) NOT NULL,
  `employee_uuid` VARCHAR(36) NOT NULL,
  `image_key` VARCHAR(500) NOT NULL COMMENT 'S3 key or file path',
  `image_number` TINYINT NOT NULL CHECK (`image_number` BETWEEN 1 AND 7),
  `descriptor_json` TEXT DEFAULT NULL COMMENT 'Face encoding descriptor for recognition',
  `created_at` DATETIME NOT NULL DEFAULT CURRENT_TIMESTAMP(),
  `updated_at` DATETIME NOT NULL DEFAULT CURRENT_TIMESTAMP() ON UPDATE CURRENT_TIMESTAMP(),
  PRIMARY KEY (`uuid`),
  UNIQUE KEY `uk_positions_code` (`position_code`),
  UNIQUE KEY `uk_face_images_employee_number` (`employee_uuid`, `image_number`),
  KEY `idx_face_images_employee` (`employee_uuid`),
  CONSTRAINT `fk_face_images_employee` FOREIGN KEY (`employee_uuid`) REFERENCES `Employees` (`uuid`) ON DELETE CASCADE
) ENGINE=InnoDB DEFAULT CHARSET=utf8mb4 COLLATE=utf8mb4_unicode_ci
COMMENT='Face recognition images for biometric attendance';

--
-- Table: EmployeeOccupations
-- Purpose: Many-to-many relationship between employees and occupations (temporal)
-- 1NF: ✓ Atomic values
-- 2NF: ✓ All attributes depend on entire composite key
-- 3NF: ✓ No transitive dependencies
-- NOTE: Source of truth for employee occupations
--
-- DEPRECATED: Will be removed
-- DROP TABLE IF EXISTS `EmployeeOccupations`;
-- DEPRECATED: To be consolidated into other tables
-- CREATE TABLE `EmployeeOccupations` (
  `uuid` VARCHAR(36) NOT NULL,
  `employee_uuid` VARCHAR(36) NOT NULL,
  `occupation_uuid` VARCHAR(36) NOT NULL,
  `assigned_at` DATETIME NOT NULL DEFAULT CURRENT_TIMESTAMP(),
  `assigned_by_uuid` VARCHAR(36) DEFAULT NULL,
  `expires_at` DATETIME DEFAULT NULL COMMENT 'NULL means no expiration',
  `assigned_reason` TEXT DEFAULT NULL,
  PRIMARY KEY (`uuid`),
  UNIQUE KEY `uk_positions_code` (`position_code`),
  UNIQUE KEY `uk_employee_occupation` (`employee_uuid`, `occupation_uuid`),
  KEY `idx_employee_occupations_employee` (`employee_uuid`),
  KEY `idx_employee_occupations_occupation` (`occupation_uuid`),
  KEY `idx_employee_occupations_expires` (`expires_at`),
  KEY `idx_employee_occupations_assigned_by` (`assigned_by_uuid`),
  CONSTRAINT `fk_employee_occupations_employee` FOREIGN KEY (`employee_uuid`) REFERENCES `Employees` (`uuid`) ON DELETE CASCADE,
  CONSTRAINT `fk_employee_occupations_occupation` FOREIGN KEY (`occupation_uuid`) REFERENCES `Occupations` (`uuid`) ON DELETE CASCADE,
  CONSTRAINT `fk_employee_occupations_assigned_by` FOREIGN KEY (`assigned_by_uuid`) REFERENCES `Users` (`uuid`) ON DELETE SET NULL
) ENGINE=InnoDB DEFAULT CHARSET=utf8mb4 COLLATE=utf8mb4_unicode_ci
COMMENT='Employee occupation assignments - SOURCE OF TRUTH for current occupations';

--
-- Table: EmployeeShifts
-- Purpose: Historical shift assignments for employees
-- 1NF: ✓ Atomic values
-- 2NF: ✓ All attributes depend on PK
-- 3NF: ✓ No transitive dependencies
--
DROP TABLE IF EXISTS `EmployeeShifts`;
CREATE TABLE `EmployeeShifts` (
  `uuid` VARCHAR(36) NOT NULL,
  `employee_uuid` VARCHAR(36) NOT NULL,
  `shift_uuid` VARCHAR(36) NOT NULL,
  `effective_from` DATE NOT NULL,
  `effective_to` DATE DEFAULT NULL COMMENT 'NULL means currently active',
  `created_at` DATETIME NOT NULL DEFAULT CURRENT_TIMESTAMP(),
  PRIMARY KEY (`uuid`),
  UNIQUE KEY `uk_positions_code` (`position_code`),
  KEY `idx_employee_shifts_employee` (`employee_uuid`),
  KEY `idx_employee_shifts_shift` (`shift_uuid`),
  KEY `idx_employee_shifts_effective` (`employee_uuid`, `effective_from`, `effective_to`),
  CONSTRAINT `fk_employee_shifts_employee` FOREIGN KEY (`employee_uuid`) REFERENCES `Employees` (`uuid`) ON DELETE CASCADE,
  CONSTRAINT `fk_employee_shifts_shift` FOREIGN KEY (`shift_uuid`) REFERENCES `ShiftDefinitions` (`uuid`) ON DELETE RESTRICT,
  CONSTRAINT `chk_employee_shifts_dates` CHECK (`effective_to` IS NULL OR `effective_to` >= `effective_from`)
) ENGINE=InnoDB DEFAULT CHARSET=utf8mb4 COLLATE=utf8mb4_unicode_ci
COMMENT='Historical shift assignments for employees';

--
-- Table: EmployeeRegistrationDrafts
-- Purpose: Temporary storage for multi-step employee registration
-- 1NF: ✓ Atomic values (draft_json represents single registration state)
-- 2NF: ✓ All attributes depend on PK
-- 3NF: ✓ No transitive dependencies
--
DROP TABLE IF EXISTS `EmployeeRegistrationDrafts`;
CREATE TABLE `EmployeeRegistrationDrafts` (
  `uuid` VARCHAR(36) NOT NULL,
  `step_completed` TINYINT DEFAULT NULL COMMENT 'Last completed step in registration wizard',
  `draft_json` JSON DEFAULT NULL COMMENT 'Partial employee data',
  `created_at` DATETIME NOT NULL DEFAULT CURRENT_TIMESTAMP(),
  `updated_at` DATETIME NOT NULL DEFAULT CURRENT_TIMESTAMP() ON UPDATE CURRENT_TIMESTAMP(),
  PRIMARY KEY (`uuid`)
) ENGINE=InnoDB DEFAULT CHARSET=utf8mb4 COLLATE=utf8mb4_unicode_ci
COMMENT='Temporary drafts for multi-step employee registration';

--
-- Table: OccupationDelegations
-- Purpose: Temporary delegation of occupation-based permissions
-- 1NF: ✓ Atomic values
-- 2NF: ✓ All attributes depend on PK
-- 3NF: ✓ No transitive dependencies
--
-- DEPRECATED: Will be removed
-- DROP TABLE IF EXISTS `OccupationDelegations`;
-- DEPRECATED: To be consolidated into other tables
-- CREATE TABLE `OccupationDelegations` (
  `uuid` VARCHAR(36) NOT NULL,
  `delegator_user_uuid` VARCHAR(36) NOT NULL,
  `delegatee_user_uuid` VARCHAR(36) NOT NULL,
  `occupation_uuid` VARCHAR(36) NOT NULL,
  `start_date` DATETIME NOT NULL,
  `end_date` DATETIME NOT NULL,
  `delegation_reason` TEXT DEFAULT NULL,
  `revoked_at` DATETIME DEFAULT NULL,
  `revoked_by_uuid` VARCHAR(36) DEFAULT NULL,
  `delegation_chain_level` INT DEFAULT NULL COMMENT 'Track delegation depth to prevent abuse',
  `original_delegator_uuid` VARCHAR(36) DEFAULT NULL COMMENT 'Original delegator if chained',
  `created_at` DATETIME NOT NULL DEFAULT CURRENT_TIMESTAMP(),
  PRIMARY KEY (`uuid`),
  UNIQUE KEY `uk_positions_code` (`position_code`),
  KEY `idx_delegations_delegatee` (`delegatee_user_uuid`),
